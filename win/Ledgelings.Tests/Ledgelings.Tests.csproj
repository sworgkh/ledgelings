<Project Sdk="Microsoft.NET.Sdk">
  <!-- App-side tests that need no window: the chat client, the catalogue, settings, the atlas. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- As in the app: WinForms only for GDI+ (System.Drawing), which the atlas tests read pixels from. -->
    <UseWindowsForms>true</UseWindowsForms>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Ledgelings.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LedgelingsCore\LedgelingsCore.csproj" />
    <ProjectReference Include="..\Ledgelings\Ledgelings.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Ledgelings.Core" />
    <!-- The WPF SDK leaves these out of its implicit usings. -->
    <Using Include="System.IO" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
</Project>
