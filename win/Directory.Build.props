<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Lets a Mac or Linux machine compile the WPF app (it cannot run it): the core tests run anywhere. -->
    <EnableWindowsTargeting Condition="'$(OS)' != 'Windows_NT'">true</EnableWindowsTargeting>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Version>0.29.0</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>Evgeny Alterman</Authors>
    <Product>Ledgelings</Product>
  </PropertyGroup>
</Project>
