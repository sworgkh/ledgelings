<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pure logic: no window, no Win32. Everything worth unit-testing lives here. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Ledgelings.Core</RootNamespace>
    <AssemblyName>LedgelingsCore</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- The Mac app's Russian, exported by its SharedTextTests: one source for both apps' words. -->
    <EmbeddedResource Include="..\..\Sources\LedgelingsCore\l10n\*.json" LogicalName="l10n.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
