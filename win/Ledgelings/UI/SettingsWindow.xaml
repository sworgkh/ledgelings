<Window x:Class="Ledgelings.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Ledgelings.UI"
        ui:Tr.Title="Ledgelings Settings" Width="980" Height="720" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
  <Window.Resources>
    <Style x:Key="Footer" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="Gray"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>
    <Style x:Key="RowLabel" TargetType="TextBlock">
      <Setter Property="Width" Value="110"/>
      <!-- Russian labels run longer: they wrap rather than lose their ends. -->
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="RowValue" TargetType="TextBlock">
      <Setter Property="Width" Value="70"/>
      <Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="DockPanel.Dock" Value="Right"/>
    </Style>
    <Style TargetType="GroupBox">
      <Setter Property="Padding" Value="8"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style TargetType="Slider">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="IsSnapToTickEnabled" Value="True"/>
    </Style>
  </Window.Resources>
  <!-- A sidebar of every page under its group's heading, with a search box (SettingsWindow.Sidebar.cs);
       the pages are a TabControl with no tab strip, each found by its Tr.Header (SettingsPage's English title). -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="230"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" BorderBrush="#22000000" BorderThickness="0,0,1,0">
      <DockPanel>
        <Border DockPanel.Dock="Top" Margin="10,12,10,8" Padding="6,0" Height="28" CornerRadius="5" Background="White" BorderBrush="#33000000" BorderThickness="1">
          <DockPanel>
            <Image x:Name="SearchIcon" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            <Button x:Name="ClearSearch" DockPanel.Dock="Right" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Padding="2" Cursor="Hand" Click="ClearSearch_Click">
              <Image x:Name="ClearIcon" Width="12" Height="12" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </Button>
            <Grid>
              <TextBlock x:Name="SearchHint" ui:Tr.Text="Search settings" Foreground="Gray" VerticalAlignment="Center" IsHitTestVisible="False"/>
              <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" TextChanged="SearchBox_Changed" PreviewKeyDown="SearchBox_Key"/>
            </Grid>
          </DockPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="Sidebar" Margin="8,0,8,12"/>
        </ScrollViewer>
      </DockPanel>
    </Border>
    <DockPanel Grid.Column="1">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,12,16,0">
        <TextBlock x:Name="PageTitle" FontSize="16" FontWeight="Bold" VerticalAlignment="Bottom"/>
        <TextBlock x:Name="PageGroup" FontSize="10" FontWeight="Bold" Foreground="Gray" Margin="10,0,0,2" VerticalAlignment="Bottom"/>
      </StackPanel>
  <TabControl x:Name="Tabs" BorderThickness="0" Padding="4,0,0,0" SelectionChanged="Tabs_SelectionChanged">
    <TabControl.Template>
      <ControlTemplate TargetType="TabControl">
        <ContentPresenter ContentSource="SelectedContent" Margin="{TemplateBinding Padding}"/>
      </ControlTemplate>
    </TabControl.Template>
    <TabItem ui:Tr.Header="Creatures">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
          <GroupBox ui:Tr.Header="Creatures">
            <StackPanel>
              <DockPanel Margin="0,4">
                <TextBlock ui:Tr.Text="How many" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" Text="{Binding CreatureCount}"/>
                <Slider Minimum="1" Maximum="24" TickFrequency="1" Value="{Binding CreatureCount, Mode=TwoWay}"/>
              </DockPanel>
              <DockPanel Margin="0,4">
                <TextBlock ui:Tr.Text="Smallest" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" ui:Tr.Value="{Binding MinSize}" ui:Tr.Unit="×"/>
                <Slider Minimum="1" Maximum="5" TickFrequency="0.5" Value="{Binding MinSize, Mode=TwoWay}"/>
              </DockPanel>
              <DockPanel Margin="0,4">
                <TextBlock ui:Tr.Text="Largest" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" ui:Tr.Value="{Binding MaxSize}" ui:Tr.Unit="×"/>
                <Slider Minimum="1" Maximum="5" TickFrequency="0.5" Value="{Binding MaxSize, Mode=TwoWay}"/>
              </DockPanel>
              <DockPanel Margin="0,4">
                <TextBlock ui:Tr.Text="Live on" Style="{StaticResource RowLabel}"/>
                <ComboBox x:Name="ScreenBox" DisplayMemberPath="Title" SelectedValuePath="Id" Width="220" HorizontalAlignment="Left"
                          SelectionChanged="ScreenBox_Changed" DropDownOpened="ScreenBox_Opened"/>
              </DockPanel>
              <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="Every creature gets its own size between the two. Set them equal and they all match. On a high-dpi monitor the sizes scale with it, so 3× is the same size as on a Mac. Live on: keep them all on one monitor; choose another and they parachute over. While it is unplugged they use every screen, and go back when it returns."/>
            </StackPanel>
          </GroupBox>
          <GroupBox ui:Tr.Header="Colours">
            <StackPanel>
              <ItemsControl x:Name="ColourList">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Width="36" Height="36" Margin="4" Background="{Binding Brush}" Tag="{Binding Index}" ToolTip="{Binding Hex}" Click="Colour_Click" BorderBrush="Gray"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <DockPanel Margin="0,6,0,0">
                <Button DockPanel.Dock="Right" ui:Tr.Content="Reset" Click="ResetColours_Click"/>
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="AddColour" ui:Tr.Content="Add Colour" Click="AddColour_Click" Margin="0,0,8,0"/>
                  <Button x:Name="RemoveColour" ui:Tr.Content="Remove Last" Click="RemoveColour_Click"/>
                </StackPanel>
              </DockPanel>
              <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="Creature 1 wears the first colour, creature 2 the second, and so on, starting over when the colours run out. Click a swatch to change it."/>
            </StackPanel>
          </GroupBox>
          <GroupBox ui:Tr.Header="Tea parties">
            <StackPanel>
              <CheckBox ui:Tr.Content="Sit down to tea now and then" IsChecked="{Binding TeaPartiesEnabled, Mode=TwoWay}"/>
              <DockPanel Margin="0,6,0,4" IsEnabled="{Binding TeaPartiesEnabled}">
                <TextBlock ui:Tr.Text="Share of bumps" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" ui:Tr.Value="{Binding TeaPartyChance}" ui:Tr.Unit="%"/>
                <Slider Minimum="1" Maximum="100" TickFrequency="1" Value="{Binding TeaPartyChance, Mode=TwoWay}"/>
              </DockPanel>
              <DockPanel Margin="0,4" IsEnabled="{Binding TeaPartiesEnabled}">
                <TextBlock ui:Tr.Text="Lasts" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" ui:Tr.Value="{Binding TeaPartyMinutes}" ui:Tr.Unit=" min"/>
                <Slider Minimum="1" Maximum="10" TickFrequency="0.5" Value="{Binding TeaPartyMinutes, Mode=TwoWay}"/>
              </DockPanel>
              <DockPanel Margin="0,4" IsEnabled="{Binding TeaPartiesEnabled}">
                <TextBlock ui:Tr.Text="Sip between stories" Style="{StaticResource RowLabel}" Width="130"/>
                <TextBlock Style="{StaticResource RowValue}" ui:Tr.Value="{Binding TeaSipSeconds}" ui:Tr.Unit=" s"/>
                <Slider Minimum="0" Maximum="30" TickFrequency="1" Value="{Binding TeaSipSeconds, Mode=TwoWay}"/>
              </DockPanel>
              <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="Now and then two creatures who bump into each other put a little table out between them and sit down to tea, taking turns to tell each other stories from their lives. One party at a time. With talk off they just sip."/>
            </StackPanel>
          </GroupBox>
          <GroupBox ui:Tr.Header="Day and night">
            <StackPanel>
              <DockPanel Margin="0,4">
                <TextBlock ui:Tr.Text="Day lasts" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" ui:Tr.Value="{Binding DayMinutes}" ui:Tr.Unit=" min"/>
                <Slider Minimum="0.5" Maximum="60" TickFrequency="0.5" Value="{Binding DayMinutes, Mode=TwoWay}"/>
              </DockPanel>
              <DockPanel Margin="0,4">
                <TextBlock ui:Tr.Text="Night lasts" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" ui:Tr.Value="{Binding NightMinutes}" ui:Tr.Unit=" min" ui:Tr.Zero="never"/>
                <Slider Minimum="0" Maximum="60" TickFrequency="0.5" Value="{Binding NightMinutes, Mode=TwoWay}"/>
              </DockPanel>
              <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="They walk by day and sleep by night. Set the night to 0 and they never sleep. A cursor still startles a sleeper awake."/>
            </StackPanel>
          </GroupBox>
          <GroupBox ui:Tr.Header="The cursor">
            <StackPanel>
              <DockPanel Margin="0,0,0,6">
                <TextBlock ui:Tr.Text="The cursor is" Style="{StaticResource RowLabel}"/>
                <ComboBox x:Name="CursorMoodBox" DisplayMemberPath="Title" SelectedValuePath="Mood" SelectedValue="{Binding CursorMood, Mode=TwoWay}" Width="160" HorizontalAlignment="Left"/>
              </DockPanel>
              <CheckBox ui:Tr.Content="Complain when pushed around" IsChecked="{Binding ComplainEnabled, Mode=TwoWay}"/>
              <DockPanel Margin="0,6,0,4" IsEnabled="{Binding ComplainEnabled}">
                <TextBlock ui:Tr.Text="Puts up with" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" ui:Tr.Value="{Binding ComplainAfter}" ui:Tr.Format="%d in a row"/>
                <Slider Minimum="1" Maximum="20" TickFrequency="1" Value="{Binding ComplainAfter, Mode=TwoWay}"/>
              </DockPanel>
              <DockPanel Margin="0,4" IsEnabled="{Binding ComplainEnabled}">
                <TextBlock ui:Tr.Text="Calms down after" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" ui:Tr.Value="{Binding ComplainCalmSeconds}" ui:Tr.Unit=" s"/>
                <Slider Minimum="5" Maximum="120" TickFrequency="5" Value="{Binding ComplainCalmSeconds, Mode=TwoWay}"/>
              </DockPanel>
              <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="A playmate: a chase is a game of tag. Just there: they hop aside. A menace: a grudge. Chase one too often in a row and it says so in its own voice."/>
            </StackPanel>
          </GroupBox>
          <GroupBox ui:Tr.Header="Language and startup">
            <StackPanel>
              <DockPanel Margin="0,0,0,6">
                <TextBlock ui:Tr.Text="Language" Style="{StaticResource RowLabel}"/>
                <ComboBox x:Name="LanguageBox" DisplayMemberPath="Title" SelectedValuePath="Language" SelectedValue="{Binding Language, Mode=TwoWay}" Width="160" HorizontalAlignment="Left"/>
              </DockPanel>
              <CheckBox x:Name="StartAtLogin" ui:Tr.Content="Start Ledgelings when you log in" Checked="StartAtLogin_Changed" Unchecked="StartAtLogin_Changed"/>
              <TextBlock Margin="0,4,0,0"><Run ui:Tr.Text="Status"/><Run Text=": "/><Run x:Name="LoginStatus" Foreground="Gray"/></TextBlock>
              <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="Menus, settings and what the creatures say. Prompts you edited stay as written. Login uses the per-user Startup list; Task Manager › Startup apps shows it too."/>
            </StackPanel>
          </GroupBox>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem ui:Tr.Header="Actions">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
          <GroupBox ui:Tr.Header="Creature Actions">
            <StackPanel>
              <CheckBox ui:Tr.Content="Keep the sheet up after an action" IsChecked="{Binding ActionsStayOpen, Mode=TwoWay}"/>
              <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="On, the Creature Actions sheet stays up until you press Done; off, it folds away after one action."/>
            </StackPanel>
          </GroupBox>
          <GroupBox ui:Tr.Header="When the icon is hidden">
            <StackPanel>
              <CheckBox ui:Tr.Content="Shortcut from any app" IsChecked="{Binding ShortcutEnabled, Mode=TwoWay}"/>
              <DockPanel Margin="0,6,0,4" IsEnabled="{Binding ShortcutEnabled}">
                <TextBlock ui:Tr.Text="Shortcut" Style="{StaticResource RowLabel}"/>
                <Button x:Name="ShortcutButton" Click="ShortcutButton_Click" MinWidth="120" Padding="10,3" HorizontalAlignment="Left"/>
              </DockPanel>
              <TextBlock x:Name="ShortcutProblemText" Text="{Binding ShortcutProblem}" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,2,0,4"/>
              <CheckBox ui:Tr.Content="Opening Ledgelings again shows the sheet" IsChecked="{Binding ReopenShowsActions, Mode=TwoWay}"/>
              <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="Windows tucks tray icons away when there are many. The shortcut brings the Creature Actions sheet up whichever app is in front, and pressed again puts it away; the sheet has the menu's switches, Settings and Quit. Click the shortcut to record another: a key with Ctrl, Alt or the Windows key held. Esc keeps the old one. Or start Ledgelings again from the Start menu."/>
            </StackPanel>
          </GroupBox>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem ui:Tr.Header="Chases">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
          <GroupBox ui:Tr.Header="Counting">
            <StackPanel>
              <CheckBox ui:Tr.Content="Count chases and pick-ups" IsChecked="{Binding HuntCountEnabled, Mode=TwoWay}"/>
              <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="Every time the cursor chases a creature off its edge or picks it up, it counts, by character: today, this week and in all. Days and weeks follow your calendar. Off, nothing is counted and the numbers stay as they are."/>
            </StackPanel>
          </GroupBox>
          <GroupBox ui:Tr.Header="Talking about it">
            <StackPanel>
              <CheckBox ui:Tr.Content="They know their count" IsChecked="{Binding HuntTalkEnabled, Mode=TwoWay}"/>
              <DockPanel Margin="0,6,0,4" IsEnabled="{Binding HuntTalkEnabled}">
                <TextBlock ui:Tr.Text="How often it comes up" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" ui:Tr.Value="{Binding HuntTalkChance}" ui:Tr.Unit="%"/>
                <Slider Minimum="0" Maximum="100" TickFrequency="5" Value="{Binding HuntTalkChance, Mode=TwoWay}"/>
              </DockPanel>
              <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="This share of conversations, tea stories and paper planes carries the numbers: with a model they go into its prompt, compared with yesterday and the week, with any record; with the built-in lines a creature says its count in its own voice. A complaint always knows them, and a round number or a record day is said out loud. How they take it follows the cursor mood: a score, a fact, or a grudge. No extra model calls."/>
            </StackPanel>
          </GroupBox>
          <GroupBox ui:Tr.Header="Wariness" IsEnabled="{Binding HuntCountEnabled}">
            <StackPanel>
              <CheckBox ui:Tr.Content="Much-chased creatures keep their distance" IsChecked="{Binding HuntWary, Mode=TwoWay}"/>
              <DockPanel Margin="0,6,0,4" IsEnabled="{Binding HuntWary}">
                <TextBlock ui:Tr.Text="After" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" Width="110" ui:Tr.Value="{Binding HuntWaryAfter}" ui:Tr.Format="%d in a day"/>
                <Slider Minimum="5" Maximum="200" TickFrequency="5" Value="{Binding HuntWaryAfter, Mode=TwoWay}"/>
              </DockPanel>
              <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="When the cursor is a menace, a creature chased this often today jumps away from further off, until tomorrow."/>
            </StackPanel>
          </GroupBox>
          <GroupBox ui:Tr.Header="Revenge">
            <StackPanel>
              <CheckBox ui:Tr.Content="Grab the cursor in revenge" IsChecked="{Binding RevengeEnabled, Mode=TwoWay}"/>
              <StackPanel IsEnabled="{Binding RevengeEnabled}">
                <DockPanel Margin="0,6,0,4">
                  <TextBlock ui:Tr.Text="After" Style="{StaticResource RowLabel}"/>
                  <TextBlock Style="{StaticResource RowValue}" Width="110" ui:Tr.Value="{Binding RevengeAfter}" ui:Tr.Count="time|times"/>
                  <Slider Minimum="3" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding RevengeAfter, Mode=TwoWay}"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,4">
                  <TextBlock ui:Tr.Text="Within" Style="{StaticResource RowLabel}"/>
                  <TextBlock Style="{StaticResource RowValue}" ui:Tr.Value="{Binding RevengeWindowSeconds}" ui:Tr.Unit=" s"/>
                  <Slider Minimum="30" Maximum="600" TickFrequency="30" IsSnapToTickEnabled="True" Value="{Binding RevengeWindowSeconds, Mode=TwoWay}"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,4">
                  <TextBlock ui:Tr.Text="Holds on for at most" Style="{StaticResource RowLabel}"/>
                  <TextBlock Style="{StaticResource RowValue}" ui:Tr.Value="{Binding RevengeHoldSeconds}" ui:Tr.Unit=" s" ui:Tr.Zero="no limit"/>
                  <Slider Minimum="0" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding RevengeHoldSeconds, Mode=TwoWay}"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,4">
                  <TextBlock ui:Tr.Text="Tells you off again every" Style="{StaticResource RowLabel}"/>
                  <TextBlock Style="{StaticResource RowValue}" ui:Tr.Value="{Binding RevengeTauntSeconds}" ui:Tr.Unit=" s" ui:Tr.Zero="never"/>
                  <Slider Minimum="0" Maximum="60" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding RevengeTauntSeconds, Mode=TwoWay}"/>
                </DockPanel>
                <CheckBox Margin="0,0,0,4" ui:Tr.Content="Holds the pointer still" IsChecked="{Binding RevengePinsCursor, Mode=TwoWay}"/>
                <DockPanel Margin="0,0,0,4">
                  <TextBlock ui:Tr.Text="Then peace for" Style="{StaticResource RowLabel}"/>
                  <TextBlock Style="{StaticResource RowValue}" ui:Tr.Value="{Binding RevengeCooldownMinutes}" ui:Tr.Unit=" min"/>
                  <Slider Minimum="1" Maximum="120" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding RevengeCooldownMinutes, Mode=TwoWay}"/>
                </DockPanel>
              </StackPanel>
              <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="Chased or picked up this often in that time, a creature jumps on the cursor and rides along on it, telling you off now and then in its own words and the cursor mood, until you shake it off or the limit runs out. Holding the pointer still, you cannot move it until it lets go, after 10 s at the latest. Escape lets go too, whichever app is in front. No permission is needed."/>
            </StackPanel>
          </GroupBox>
          <GroupBox ui:Tr.Header="Shaking it off" IsEnabled="{Binding RevengeEnabled}">
            <StackPanel>
              <DockPanel Margin="0,6,0,4">
                <TextBlock ui:Tr.Text="Shakes to break free" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" ui:Tr.Value="{Binding RevengeShakes}"/>
                <Slider Minimum="2" Maximum="16" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding RevengeShakes, Mode=TwoWay}"/>
              </DockPanel>
              <DockPanel Margin="0,0,0,4">
                <TextBlock ui:Tr.Text="Each shake at least" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" ui:Tr.Value="{Binding RevengeShakeStroke}" ui:Tr.Unit=" pt"/>
                <Slider Minimum="10" Maximum="60" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding RevengeShakeStroke, Mode=TwoWay}"/>
              </DockPanel>
              <DockPanel Margin="0,0,0,4">
                <TextBlock ui:Tr.Text="Shakes within" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" ui:Tr.Value="{Binding RevengeShakeWindowSeconds}" ui:Tr.Unit=" s"/>
                <Slider Minimum="1" Maximum="4" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding RevengeShakeWindowSeconds, Mode=TwoWay}"/>
              </DockPanel>
              <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="Move the mouse back and forth: this many turns, each after a stroke this long, within this time. Fewer, shorter, slower is gentler."/>
            </StackPanel>
          </GroupBox>
          <GroupBox ui:Tr.Header="The count">
            <StackPanel>
              <Grid Margin="0,0,0,4" TextElement.Foreground="Gray" TextElement.FontSize="11">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="80"/><ColumnDefinition Width="80"/><ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" ui:Tr.Text="Creature"/>
                <TextBlock Grid.Column="1" ui:Tr.Text="Today" TextAlignment="Right"/>
                <TextBlock Grid.Column="2" ui:Tr.Text="This week" TextAlignment="Right"/>
                <TextBlock Grid.Column="3" ui:Tr.Text="In all" TextAlignment="Right"/>
              </Grid>
              <ItemsControl x:Name="HuntList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,2">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="80"/><ColumnDefinition Width="80"/><ColumnDefinition Width="90"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="{Binding Weight}"/>
                      <TextBlock Grid.Column="1" Text="{Binding Today}" TextAlignment="Right" FontWeight="{Binding Weight}"/>
                      <TextBlock Grid.Column="2" Text="{Binding Week}" TextAlignment="Right" FontWeight="{Binding Weight}"/>
                      <TextBlock Grid.Column="3" Text="{Binding All}" TextAlignment="Right" FontWeight="{Binding Weight}"/>
                      <Button Grid.Column="4" ui:Tr.Content="Reset" Tag="{Binding Name}" Click="ResetHunt_Click" FontSize="11" Padding="6,0"
                              HorizontalAlignment="Right" Visibility="{Binding ResetVisibility}" IsEnabled="{Binding CanReset}"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock x:Name="HuntsSince" Style="{StaticResource Footer}"/>
            </StackPanel>
          </GroupBox>
          <GroupBox ui:Tr.Header="The file">
            <DockPanel>
              <Button DockPanel.Dock="Right" x:Name="ResetAllHunts" ui:Tr.Content="Reset All…" Click="ResetAllHunts_Click" Margin="8,0,0,0"/>
              <Button DockPanel.Dock="Right" ui:Tr.Content="Show in Explorer" Click="RevealHunts_Click"/>
              <TextBlock x:Name="HuntsPath" FontSize="11" Foreground="Gray" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </DockPanel>
          </GroupBox>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem ui:Tr.Header="Beds">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
          <GroupBox ui:Tr.Header="Beds">
            <StackPanel>
              <CheckBox ui:Tr.Content="Each one sleeps in its own bed" IsChecked="{Binding BedsEnabled, Mode=TwoWay}"/>
              <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="Every character has a bed of its own, picked for who it is: a crate for Blocky, a basket for Mittens, a lily pad for Hopper. Falling asleep, it puts the bed down and sleeps on it; waking, it folds it away. Off, they sleep on the bare edge as before."/>
            </StackPanel>
          </GroupBox>
          <GroupBox ui:Tr.Header="The favourite place" IsEnabled="{Binding BedsEnabled}">
            <StackPanel>
              <DockPanel Margin="0,6,0,4">
                <TextBlock ui:Tr.Text="Pull of the favourite place" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" ui:Tr.Value="{Binding BedPull}" ui:Tr.Unit="%"/>
                <Slider Minimum="0" Maximum="100" TickFrequency="5" Value="{Binding BedPull, Mode=TwoWay}"/>
              </DockPanel>
              <DockPanel Margin="0,0,0,4">
                <TextBlock ui:Tr.Text="Walks to it at most" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" ui:Tr.Value="{Binding BedWalkDistance}" ui:Tr.Unit=" pt"/>
                <Slider Minimum="100" Maximum="6000" TickFrequency="100" Value="{Binding BedWalkDistance, Mode=TwoWay}"/>
              </DockPanel>
              <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="At nightfall a creature gets up and walks to its favourite place, if it is on the same screen outline and no further along the edge than this. The first night it picks a place its character likes (Blocky the bottom edge, Pip the ceiling). Each night there makes it likelier to go back, up to this pull; a night slept elsewhere wears the habit down, and enough of them move it. A nap you ask for is slept where it is."/>
            </StackPanel>
          </GroupBox>
          <GroupBox ui:Tr.Header="Talking about it" IsEnabled="{Binding BedsEnabled}">
            <StackPanel>
              <CheckBox ui:Tr.Content="Say something about it now and then" IsChecked="{Binding BedTalk, Mode=TwoWay}"/>
              <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="Some nights a creature says a line as it lies down, in its own voice, and it mumbles something when you move its bed. Built-in lines: no model calls."/>
            </StackPanel>
          </GroupBox>
          <GroupBox ui:Tr.Header="Who sleeps where">
            <StackPanel>
              <ItemsControl x:Name="BedList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,3">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="84"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/>
                      </Grid.ColumnDefinitions>
                      <Image Grid.Column="0" Source="{Binding Picture}" Width="72" Height="32" HorizontalAlignment="Left"
                             RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True"/>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}"/>
                        <TextBlock Text="{Binding Bed}" FontSize="11" Foreground="Gray" TextWrapping="Wrap"/>
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding Where}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="6,0"/>
                      <Button Grid.Column="3" ui:Tr.Content="Forget" Tag="{Binding Name}" Click="ForgetBed_Click" FontSize="11" Padding="6,0"
                              HorizontalAlignment="Right" VerticalAlignment="Center" IsEnabled="{Binding CanForget}"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="Drag a sleeper's bed, by its edge or the part under its feet, to anywhere on an edge: it lands there, still asleep, and that is its favourite place from now on. Dragging a bed is not a chase. Kept by name: rename a character and it looks for a place afresh."/>
            </StackPanel>
          </GroupBox>
          <GroupBox ui:Tr.Header="The file">
            <DockPanel>
              <Button DockPanel.Dock="Right" x:Name="ForgetAllBeds" ui:Tr.Content="Forget All Places…" Click="ForgetAllBeds_Click" Margin="8,0,0,0"/>
              <Button DockPanel.Dock="Right" ui:Tr.Content="Show in Explorer" Click="RevealBeds_Click"/>
              <TextBlock x:Name="BedsPath" FontSize="11" Foreground="Gray" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </DockPanel>
          </GroupBox>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem ui:Tr.Header="Play">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
          <GroupBox ui:Tr.Header="Playing">
            <StackPanel>
              <CheckBox ui:Tr.Content="They play now and then" IsChecked="{Binding PlayEnabled, Mode=TwoWay}"/>
              <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="Now and then a creature stops walking and plays, the way the worms in Worms fool about between turns, with nobody hurt. One game at a time, never in the middle of a talk, a tea party, a flower, a plane, a grab or sleep; the players are left alone until it is over."/>
            </StackPanel>
          </GroupBox>
          <GroupBox ui:Tr.Header="Which games" IsEnabled="{Binding PlayEnabled}">
            <StackPanel>
              <CheckBox ui:Tr.Content="Catch me if you can (two)" IsChecked="{Binding PlayTagEnabled, Mode=TwoWay}"/>
              <CheckBox ui:Tr.Content="Ninja rope swing" IsChecked="{Binding PlayRopeEnabled, Mode=TwoWay}"/>
              <CheckBox ui:Tr.Content="Parachute jump" IsChecked="{Binding PlayParachuteEnabled, Mode=TwoWay}"/>
              <CheckBox ui:Tr.Content="Basketball (alone, or two taking turns)" IsChecked="{Binding PlayBasketballEnabled, Mode=TwoWay}"/>
              <CheckBox ui:Tr.Content="Soccer (anyone free, in teams)" IsChecked="{Binding PlaySoccerEnabled, Mode=TwoWay}"/>
              <CheckBox ui:Tr.Content="Baseball (anyone free, round every edge)" IsChecked="{Binding PlayBaseballEnabled, Mode=TwoWay}"/>
              <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="Tag is for two: they chase each other round the edges, and a touch makes the other one &quot;it&quot;. The rope is fired at the ceiling to swing across the floor; the parachute jump starts from the ceiling; the hoop goes on a wall at the end of a floor. Soccer and baseball are for whoever is free, and have a tab of their own: Ball games. Off, a game is never played, and its row on the Activities page is greyed."/>
            </StackPanel>
          </GroupBox>
          <GroupBox ui:Tr.Header="How often" IsEnabled="{Binding PlayEnabled}">
            <StackPanel>
              <DockPanel Margin="0,6,0,4">
                <TextBlock ui:Tr.Text="A game about every" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" ui:Tr.Value="{Binding PlayEveryMinutes}" ui:Tr.Unit=" min"/>
                <Slider Minimum="1" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding PlayEveryMinutes, Mode=TwoWay}"/>
              </DockPanel>
              <DockPanel Margin="0,0,0,4">
                <TextBlock ui:Tr.Text="Friends play more often by" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" ui:Tr.Value="{Binding PlayBondBoost}" ui:Tr.Unit="%"/>
                <Slider Minimum="0" Maximum="300" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding PlayBondBoost, Mode=TwoWay}"/>
              </DockPanel>
              <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="The wait between games is this many minutes, give or take, shortened by how close the closest pair on screen is: at 100 % the best of friends play twice as often. Close pairs (who have shared a few talks, tea parties, flowers) play tag and take turns at the hoop; strangers play alone."/>
            </StackPanel>
          </GroupBox>
          <GroupBox ui:Tr.Header="How the games go" IsEnabled="{Binding PlayEnabled}">
            <StackPanel>
              <DockPanel Margin="0,6,0,4">
                <TextBlock ui:Tr.Text="Tag lasts" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" ui:Tr.Value="{Binding TagSeconds}" ui:Tr.Unit=" s"/>
                <Slider Minimum="10" Maximum="120" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding TagSeconds, Mode=TwoWay}"/>
              </DockPanel>
              <DockPanel Margin="0,0,0,4">
                <TextBlock ui:Tr.Text="Parachute comes down at" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" ui:Tr.Value="{Binding ParachuteFallSpeed}" ui:Tr.Unit=" pt/s"/>
                <Slider Minimum="30" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding ParachuteFallSpeed, Mode=TwoWay}"/>
              </DockPanel>
              <DockPanel Margin="0,0,0,4">
                <TextBlock ui:Tr.Text="Ball keeps on each bounce" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" ui:Tr.Value="{Binding BallBounce}" ui:Tr.Unit="%"/>
                <Slider Minimum="0" Maximum="90" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding BallBounce, Mode=TwoWay}"/>
              </DockPanel>
              <DockPanel Margin="0,0,0,4">
                <TextBlock ui:Tr.Text="Throws at the hoop each" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" ui:Tr.Value="{Binding BasketballThrows}"/>
                <Slider Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding BasketballThrows, Mode=TwoWay}"/>
              </DockPanel>
              <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="After tag both stand puffing for a few seconds. The parachute sways as it comes down; slower is longer to watch. The ball bounces off the floor, the board and the rim; at 0 % it drops dead. About half the throws are aimed true; the rest fall short or bang off the board."/>
            </StackPanel>
          </GroupBox>
          <GroupBox ui:Tr.Header="Talking about it" IsEnabled="{Binding PlayEnabled}">
            <StackPanel>
              <CheckBox ui:Tr.Content="Say something as a game starts and ends" IsChecked="{Binding PlayTalk, Mode=TwoWay}"/>
              <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="Whoever starts a game says so in its own voice, and someone has the last word when it is over. With a model set up on the Talk tab, the first line is written by the model (counted under Plays, or Soccer and baseball, on the Costs tab), and a goal's or a home run's cheer too; otherwise, and for the last word, built-in lines. Needs Talk on."/>
            </StackPanel>
          </GroupBox>
          <GroupBox ui:Tr.Header="The props">
            <StackPanel>
              <ItemsControl x:Name="PropList">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Image Source="{Binding}" Width="64" Height="56" Margin="0,4,18,4" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="Drawn like the creatures, and the same for every species, your own imported ones too."/>
            </StackPanel>
          </GroupBox>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem ui:Tr.Header="Ball games">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
          <GroupBox ui:Tr.Header="Soccer" IsEnabled="{Binding PlayEnabled}">
            <StackPanel>
              <CheckBox ui:Tr.Content="Soccer (anyone free, in teams)" IsChecked="{Binding PlaySoccerEnabled, Mode=TwoWay}"/>
              <DockPanel Margin="0,6,0,4">
                <TextBlock ui:Tr.Text="Soccer at most every" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" ui:Tr.Value="{Binding SoccerEveryMinutes}" ui:Tr.Unit=" min"/>
                <Slider Minimum="2" Maximum="240" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding SoccerEveryMinutes, Mode=TwoWay}"/>
              </DockPanel>
              <DockPanel Margin="0,0,0,4">
                <TextBlock ui:Tr.Text="A match lasts up to" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" ui:Tr.Value="{Binding SoccerMinutes}" ui:Tr.Unit=" min"/>
                <Slider Minimum="0.5" Maximum="10" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding SoccerMinutes, Mode=TwoWay}"/>
              </DockPanel>
              <DockPanel Margin="0,0,0,4">
                <TextBlock ui:Tr.Text="Goals to win" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" ui:Tr.Value="{Binding SoccerGoals}"/>
                <Slider Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding SoccerGoals, Mode=TwoWay}"/>
              </DockPanel>
              <DockPanel Margin="0,0,0,4">
                <TextBlock ui:Tr.Text="Soccer players at most" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" ui:Tr.Value="{Binding SoccerPlayers}"/>
                <Slider Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding SoccerPlayers, Mode=TwoWay}"/>
              </DockPanel>
              <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="On the widest floor there is, a little net at each end. One plays keepy-uppy and shoots at an empty goal; two have a goal each; three share one goal and take turns in it; four or more split into teams of friends, a keeper each from six. First to the goals, or the best score when time is up."/>
            </StackPanel>
          </GroupBox>
          <GroupBox ui:Tr.Header="Baseball" IsEnabled="{Binding PlayEnabled}">
            <StackPanel>
              <CheckBox ui:Tr.Content="Baseball (anyone free, round every edge)" IsChecked="{Binding PlayBaseballEnabled, Mode=TwoWay}"/>
              <DockPanel Margin="0,6,0,4">
                <TextBlock ui:Tr.Text="Baseball at most every" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" ui:Tr.Value="{Binding BaseballEveryMinutes}" ui:Tr.Unit=" min"/>
                <Slider Minimum="2" Maximum="240" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding BaseballEveryMinutes, Mode=TwoWay}"/>
              </DockPanel>
              <DockPanel Margin="0,0,0,4">
                <TextBlock ui:Tr.Text="Innings" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" ui:Tr.Value="{Binding BaseballInnings}"/>
                <Slider Minimum="1" Maximum="9" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding BaseballInnings, Mode=TwoWay}"/>
              </DockPanel>
              <DockPanel Margin="0,0,0,4">
                <TextBlock ui:Tr.Text="Baseball players at most" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" ui:Tr.Value="{Binding BaseballPlayers}"/>
                <Slider Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding BaseballPlayers, Mode=TwoWay}"/>
              </DockPanel>
              <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="Home where the batter stands, the bases on the three edges furthest apart, the pitcher on the batter's floor. One practises; two to five bat in turn, a runner who must bat again leaving a pennant on its base; six or more play as two teams. Out over the top of the screen is a home run."/>
            </StackPanel>
          </GroupBox>
          <GroupBox ui:Tr.Header="Who plays">
            <StackPanel>
              <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="Whoever is free joins, closest friends first, up to the most set here; playing together brings them closer. A ball game may come up only this many minutes after the last one ended. A scoreboard sits at the top of the screen while it lasts. Their lines come with Say something on the Play tab."/>
            </StackPanel>
          </GroupBox>
          <GroupBox ui:Tr.Header="The props">
            <StackPanel>
              <ItemsControl x:Name="BallPropList">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Image Source="{Binding}" Width="64" Height="56" Margin="0,4,18,4" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="Drawn like the creatures, and the same for every species, your own imported ones too."/>
            </StackPanel>
          </GroupBox>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem ui:Tr.Header="Sprites">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
          <GroupBox ui:Tr.Header="Creatures">
            <StackPanel>
              <ItemsControl x:Name="SpeciesList">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="5" Padding="8" CornerRadius="10" BorderThickness="2" Width="118" Cursor="Hand"
                            BorderBrush="{Binding Border}" Background="{Binding Fill}" Tag="{Binding Name}" MouseLeftButtonUp="Species_Click">
                      <StackPanel>
                        <Grid>
                          <Image Source="{Binding Image}" Width="96" Height="96" RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True"/>
                          <TextBlock Text="{Binding Check}" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="18" Foreground="{Binding Border}"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                          <TextBlock Text="{Binding Name}" FontWeight="{Binding Weight}"/>
                          <Button Content="🗑" Visibility="{Binding DeleteVisibility}" Tag="{Binding Name}" Click="Species_Delete"
                                  Margin="6,0,0,0" Padding="4,0" BorderThickness="0" Background="Transparent" ui:Tr.ToolTip="Delete this imported creature"/>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <DockPanel Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal">
                  <Button ui:Tr.Content="Open Folder" Click="OpenSpritesFolder_Click"/>
                </StackPanel>
                <TextBlock x:Name="SpriteStatus" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="Gray" TextWrapping="Wrap" FontSize="11"/>
              </DockPanel>
              <TextBlock x:Name="SpritesFooter" Style="{StaticResource Footer}"/>
            </StackPanel>
          </GroupBox>
          <GroupBox ui:Tr.Header="Sprite kit: the new creature">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Style="{StaticResource RowLabel}" ui:Tr.Text="What it is"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="KitKind" Margin="0,2" TextWrapping="Wrap" AcceptsReturn="False" TextChanged="KitField_Changed"/>
                <TextBlock Grid.Row="1" Style="{StaticResource RowLabel}" ui:Tr.Text="Name"/>
                <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,2">
                  <Button DockPanel.Dock="Right" x:Name="KitSwatch" Width="44" Margin="8,0,0,0" Click="KitColour_Click" ui:Tr.ToolTip="Body colour"/>
                  <CheckBox DockPanel.Dock="Right" x:Name="KitOwnColour" ui:Tr.Content="Own colour" Margin="12,0,0,0" VerticalAlignment="Center" Click="KitOwnColour_Click"/>
                  <TextBox x:Name="KitName" TextChanged="KitField_Changed"/>
                </DockPanel>
                <TextBlock Grid.Row="2" Style="{StaticResource RowLabel}" x:Name="KitCharacter1Label"/>
                <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,2">
                  <TextBox DockPanel.Dock="Left" x:Name="KitCast0Name" Width="120" Margin="0,0,8,0" TextChanged="KitField_Changed"/>
                  <TextBox x:Name="KitCast0Persona" TextChanged="KitField_Changed"/>
                </DockPanel>
                <TextBlock Grid.Row="3" Style="{StaticResource RowLabel}" x:Name="KitCharacter2Label"/>
                <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,2">
                  <TextBox DockPanel.Dock="Left" x:Name="KitCast1Name" Width="120" Margin="0,0,8,0" TextChanged="KitField_Changed"/>
                  <TextBox x:Name="KitCast1Persona" TextChanged="KitField_Changed"/>
                </DockPanel>
                <TextBlock Grid.Row="4" Style="{StaticResource RowLabel}" x:Name="KitCharacter3Label"/>
                <DockPanel Grid.Row="4" Grid.Column="1" Margin="0,2">
                  <TextBox DockPanel.Dock="Left" x:Name="KitCast2Name" Width="120" Margin="0,0,8,0" TextChanged="KitField_Changed"/>
                  <TextBox x:Name="KitCast2Persona" TextChanged="KitField_Changed"/>
                </DockPanel>
              </Grid>
              <DockPanel Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" ui:Tr.Content="Clear" Click="KitClear_Click"/>
                <Button DockPanel.Dock="Left" x:Name="KitRefine" ui:Tr.Content="Refine with AI" Click="KitRefine_Click"/>
                <TextBlock x:Name="KitRefineNote" Margin="12,0" VerticalAlignment="Center" Foreground="Gray" TextWrapping="Wrap" FontSize="11"/>
              </DockPanel>
              <TextBlock x:Name="KitFormFooter" Style="{StaticResource Footer}"/>
            </StackPanel>
          </GroupBox>
          <GroupBox ui:Tr.Header="Ask an image model">
            <StackPanel>
              <Image x:Name="KitPoses" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True" Margin="0,2"/>
              <Image x:Name="KitTemplate" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True" Margin="0,2"/>
              <WrapPanel Margin="0,8,0,0">
                <Button x:Name="CopyPrompt" ui:Tr.Content="Copy Prompt" Click="CopyPrompt_Click" Margin="0,0,8,4"/>
                <ToggleButton x:Name="ShowPrompt" ui:Tr.Content="Show" Click="ShowPrompt_Click" Margin="0,0,8,4"/>
                <Button ui:Tr.Content="Save Images…" Click="SaveImages_Click" Margin="0,0,8,4"/>
                <Button x:Name="CopyImages" ui:Tr.Content="Copy Images" Click="CopyImages_Click" Margin="0,0,8,4"/>
                <Button ui:Tr.Content="Import…" Click="ImportSheet_Click" Margin="0,0,8,4"/>
              </WrapPanel>
              <TextBox x:Name="PromptBox" IsReadOnly="True" TextWrapping="Wrap" FontSize="11" Height="220" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"/>
              <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="Give an image model (ChatGPT, Gemini…) the prompt and both pictures, in order: 1 the poses to copy, 2 the sheet to paint on. Import… what it paints, at any size; a text sheet (.txt) imports too."/>
            </StackPanel>
          </GroupBox>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem ui:Tr.Header="Talk">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
          <GroupBox ui:Tr.Header="Talk">
            <StackPanel>
              <CheckBox ui:Tr.Content="Creatures talk when they bump into each other" IsChecked="{Binding TalkEnabled, Mode=TwoWay}"/>
              <DockPanel Margin="0,6,0,4">
                <TextBlock ui:Tr.Text="Bubble stays" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" ui:Tr.Value="{Binding BubbleSeconds}" ui:Tr.Unit=" s"/>
                <Slider Minimum="4" Maximum="60" TickFrequency="1" Value="{Binding BubbleSeconds, Mode=TwoWay}"/>
              </DockPanel>
              <DockPanel Margin="0,4">
                <TextBlock ui:Tr.Text="Not repeating their last" Style="{StaticResource RowLabel}" Width="150"/>
                <TextBlock x:Name="LineMemoryValue" Style="{StaticResource RowValue}"/>
                <Slider Minimum="0" Maximum="40" TickFrequency="1" Value="{Binding LineMemory, Mode=TwoWay}"/>
              </DockPanel>
              <CheckBox ui:Tr.Content="Paper planes" IsChecked="{Binding PlanesEnabled, Mode=TwoWay}" Margin="0,4,0,0"/>
              <DockPanel Margin="0,6,0,4" IsEnabled="{Binding PlanesEnabled}">
                <TextBlock ui:Tr.Text="A paper plane every" Style="{StaticResource RowLabel}" Width="130"/>
                <TextBlock Style="{StaticResource RowValue}" ui:Tr.Value="{Binding PlaneMinutes}" ui:Tr.Unit=" min"/>
                <Slider Minimum="0.5" Maximum="60" TickFrequency="0.5" Value="{Binding PlaneMinutes, Mode=TwoWay}"/>
              </DockPanel>
              <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="Two creatures meeting on the same edge trade a line and a reply. Every third meeting of a pair, one gives the other a flower (the Flowers tab). Every so often one folds a note into a paper plane and throws it to another; its own wind swirls it across the screen, the catcher reads it out, thinks aloud about it and throws one answer back. &quot;Make Someone Talk&quot; and &quot;Send a Paper Plane&quot; in the menu work at any time. Longer lines stay up a little longer; a click on a bubble closes it. Each creature remembers its last lines and says something else until it has run through the rest; a model is shown them and asked for something new."/>
            </StackPanel>
          </GroupBox>
          <GroupBox ui:Tr.Header="Brain">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="BrainScript" ui:Tr.Content="Built-in lines" Checked="Brain_Checked" Margin="0,0,16,0"/>
                <RadioButton x:Name="BrainLm" Content="LM Studio" Checked="Brain_Checked" Margin="0,0,16,0"/>
                <RadioButton x:Name="BrainOr" Content="OpenRouter" Checked="Brain_Checked"/>
              </StackPanel>
              <StackPanel x:Name="ScriptPanel" Margin="0,8,0,0">
                <TextBox x:Name="ScriptBox" Text="{Binding Script, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="NoWrap"
                         FontFamily="Consolas" FontSize="12" Height="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"><Run ui:Tr.Text="Status"/><Run Text=": "/><Run x:Name="ScriptStatus" Foreground="Gray"/></TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                  <Button ui:Tr.Content="Import…" Click="ScriptImport_Click"/>
                  <Button ui:Tr.Content="Export…" Click="ScriptExport_Click" Margin="8,0,0,0"/>
                  <Button x:Name="CopyAgentPrompt" ui:Tr.Content="Copy Agent Prompt" Click="CopyAgentPrompt_Click" Margin="8,0,0,0"/>
                  <Button ui:Tr.Content="Reset Lines" Click="ScriptReset_Click" Margin="8,0,0,0"/>
                </StackPanel>
              </StackPanel>
              <StackPanel x:Name="LmPanel" Margin="0,8,0,0">
                <DockPanel>
                  <TextBlock ui:Tr.Text="Server" Width="70" VerticalAlignment="Center"/>
                  <TextBox Text="{Binding TalkServer, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <DockPanel Margin="0,4">
                  <TextBlock ui:Tr.Text="Model" Width="70" VerticalAlignment="Center"/>
                  <Button DockPanel.Dock="Right" ui:Tr.Content="Check" Click="LmCheck_Click" Margin="8,0,0,0" MinWidth="60"/>
                  <ComboBox DockPanel.Dock="Right" x:Name="LmInstalled" Width="140" Margin="8,0,0,0" Visibility="Collapsed" SelectionChanged="LmInstalled_Changed" ui:Tr.ToolTip="Installed models"/>
                  <TextBox Text="{Binding TalkModel, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"><Run ui:Tr.Text="Status"/><Run Text=": "/><Run x:Name="LmStatus" Foreground="Gray"/></TextBlock>
              </StackPanel>
              <StackPanel x:Name="OrPanel" Margin="0,8,0,0">
                <DockPanel>
                  <TextBlock ui:Tr.Text="API key" Width="70" VerticalAlignment="Center"/>
                  <PasswordBox x:Name="OrKey" PasswordChanged="OrKey_Changed"/>
                </DockPanel>
                <DockPanel Margin="0,4">
                  <TextBlock ui:Tr.Text="Model" Width="70" VerticalAlignment="Center"/>
                  <Button DockPanel.Dock="Right" ui:Tr.Content="Check" Click="OrCheck_Click" Margin="8,0,0,0" MinWidth="60"/>
                  <TextBox Text="{Binding OpenRouterModel, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"><Run ui:Tr.Text="Status"/><Run Text=": "/><Run x:Name="OrStatus" Foreground="Gray"/></TextBlock>
                <DockPanel Margin="0,8,0,4">
                  <Button DockPanel.Dock="Right" Content="↻" Click="ReloadCatalog_Click" ui:Tr.ToolTip="Fetch the list again" Margin="8,0,0,0" MinWidth="28"/>
                  <TextBox x:Name="ModelSearch" TextChanged="ModelSearch_Changed" ui:Tr.ToolTip="e.g. flash lite, gemma, free"/>
                </DockPanel>
                <ListBox x:Name="ModelList" Height="220" SelectionChanged="ModelList_Changed" HorizontalContentAlignment="Stretch">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Price}" Foreground="{Binding PriceBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <StackPanel>
                          <TextBlock Text="{Binding Id}" FontFamily="Consolas"/>
                          <TextBlock Text="{Binding Name}" FontSize="11" Foreground="Gray" Visibility="{Binding NameVisibility}"/>
                        </StackPanel>
                      </DockPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="CatalogStatus" FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0"/>
              </StackPanel>
              <DockPanel x:Name="LineTokensRow" Margin="0,8,0,0">
                <TextBlock ui:Tr.Text="Room for each line" Style="{StaticResource RowLabel}" Width="130"/>
                <TextBlock Style="{StaticResource RowValue}" Width="90" ui:Tr.Value="{Binding LineTokens}" ui:Tr.Count="token|tokens"/>
                <Slider Minimum="100" Maximum="4000" TickFrequency="100" Value="{Binding LineTokens, Mode=TwoWay}"/>
              </DockPanel>
              <TextBlock x:Name="BrainFooter" Style="{StaticResource Footer}"/>
            </StackPanel>
          </GroupBox>
          <GroupBox ui:Tr.Header="Characters">
            <StackPanel>
              <DockPanel>
                <TextBlock ui:Tr.Text="Species" Width="70" VerticalAlignment="Center"/>
                <ComboBox x:Name="CastSpecies" SelectionChanged="CastSpecies_Changed"/>
              </DockPanel>
              <TextBlock x:Name="CastKind" FontSize="11" Foreground="Gray" Margin="0,4"/>
              <ItemsControl x:Name="CastList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,4">
                      <DockPanel>
                        <Button DockPanel.Dock="Right" Content="−" Tag="{Binding Index}" Click="CastRemove_Click" Width="24" ui:Tr.ToolTip="Remove this character"/>
                        <TextBox Text="{Binding Name, Mode=OneWay}" FontWeight="Bold" Tag="{Binding Index}" LostFocus="CastName_Changed" Margin="0,0,4,0"/>
                      </DockPanel>
                      <TextBox Text="{Binding Persona, Mode=OneWay}" TextWrapping="Wrap" AcceptsReturn="True" Tag="{Binding Index}" LostFocus="CastPersona_Changed" Margin="0,2,28,0"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <DockPanel Margin="0,6,0,0">
                <Button DockPanel.Dock="Right" ui:Tr.Content="Reset Cast" Click="CastReset_Click"/>
                <Button ui:Tr.Content="Add Character" Click="CastAdd_Click" HorizontalAlignment="Left"/>
              </DockPanel>
              <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="Every species has its own cast. The first creature wearing a species is its first character, the second its second, and so on, starting over when the cast runs out. The species itself is described to the model, so a frog talks like a frog."/>
            </StackPanel>
          </GroupBox>
          <GroupBox x:Name="PromptsBox" ui:Tr.Header="Prompts">
            <StackPanel>
              <TextBlock ui:Tr.Text="Who is speaking (system prompt)" FontWeight="SemiBold"/>
              <TextBox Text="{Binding SystemPrompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" MinHeight="72" Margin="0,2,0,8"/>
              <TextBlock ui:Tr.Text="Opening line" FontWeight="SemiBold"/>
              <TextBox Text="{Binding LinePrompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" MinHeight="48" Margin="0,2,0,8"/>
              <TextBlock ui:Tr.Text="Reply" FontWeight="SemiBold"/>
              <TextBox Text="{Binding ReplyPrompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" MinHeight="60" Margin="0,2,0,8"/>
              <Button ui:Tr.Content="Reset Prompts" HorizontalAlignment="Right" Click="ResetPrompts_Click"/>
              <TextBlock x:Name="PromptFooter" Style="{StaticResource Footer}"/>
            </StackPanel>
          </GroupBox>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem ui:Tr.Header="Flowers">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
          <GroupBox ui:Tr.Header="Wearing">
            <StackPanel>
              <DockPanel Margin="0,4">
                <TextBlock ui:Tr.Text="Flower lasts" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" ui:Tr.Value="{Binding FlowerMinutes}" ui:Tr.Unit=" min"/>
                <Slider Minimum="0.5" Maximum="30" TickFrequency="0.5" Value="{Binding FlowerMinutes, Mode=TwoWay}"/>
              </DockPanel>
              <CheckBox ui:Tr.Content="The one with the flower follows the giver while it lasts" IsChecked="{Binding FollowGiver, Mode=TwoWay}"/>
              <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="Every third meeting of a pair, one gives the other a flower, worn on the head until it wilts or is planted. With the box ticked, the wearer trails the giver around the edge meanwhile. A creature wearing a flower walks past everyone without bumping."/>
            </StackPanel>
          </GroupBox>
          <GroupBox ui:Tr.Header="Planting">
            <StackPanel>
              <CheckBox ui:Tr.Content="They plant their flowers where they like" IsChecked="{Binding PlantFlowers, Mode=TwoWay}"/>
              <DockPanel Margin="0,6,0,4" IsEnabled="{Binding PlantFlowers}">
                <TextBlock ui:Tr.Text="A planted flower lasts" Style="{StaticResource RowLabel}" Width="180"/>
                <TextBlock Style="{StaticResource RowValue}" ui:Tr.Value="{Binding GardenMinutes}" ui:Tr.Unit=" min"/>
                <Slider Minimum="1" Maximum="240" TickFrequency="1" Value="{Binding GardenMinutes, Mode=TwoWay}"/>
              </DockPanel>
              <DockPanel Margin="0,4" IsEnabled="{Binding PlantFlowers}">
                <TextBlock ui:Tr.Text="Flowers in the ground at most" Style="{StaticResource RowLabel}" Width="180"/>
                <TextBlock Style="{StaticResource RowValue}" Text="{Binding GardenSize}"/>
                <Slider Minimum="1" Maximum="40" TickFrequency="1" Value="{Binding GardenSize, Mode=TwoWay}"/>
              </DockPanel>
              <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button ui:Tr.Content="Clear Planted Flowers" Click="ClearGarden_Click"/>
                <TextBlock x:Name="GardenCleared" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="Gray"/>
              </StackPanel>
              <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="After wearing it a while, each one stops following its giver, goes looking for the kind of spot its character likes and plants the flower in the edge there. What it likes comes from who it is: Blocky wants the bottom edge, Pip the ceiling, Ruth a neat row beside the others, Dot plants at once, Zed waits for dark. If nowhere suits before the flower would wilt, it plants it where it stands. Planting one more than the most wilts the oldest. Clear Planted Flowers, here or in the menu, pulls them all up at once. Planted flowers are not kept when the app quits."/>
            </StackPanel>
          </GroupBox>
          <GroupBox ui:Tr.Header="Who plants where">
            <StackPanel>
              <ItemsControl x:Name="PlanterList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,3">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Width="110" VerticalAlignment="Top"/>
                      <TextBlock Text="{Binding Temper}" TextWrapping="Wrap"/>
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="Read from each character's description and its species on the Talk tab, the same way voices are cast: words like bottom, ceiling, corner, quiet, cheerful, counts, sleepy or fast. Edit a description and this changes with it."/>
            </StackPanel>
          </GroupBox>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem ui:Tr.Header="Bonds">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
          <GroupBox ui:Tr.Header="Stories">
            <StackPanel>
              <CheckBox x:Name="PlotsToggle" ui:Tr.Content="Pairs who live together get a story" IsChecked="{Binding PlotsEnabled, Mode=TwoWay}"/>
              <DockPanel x:Name="PlotAfterRow" Margin="0,6,0,4">
                <TextBlock ui:Tr.Text="First story after" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" ui:Tr.Value="{Binding PlotAfterHours}" ui:Tr.Unit=" h"/>
                <Slider Minimum="0.25" Maximum="72" TickFrequency="0.25" Value="{Binding PlotAfterHours, Mode=TwoWay}"/>
              </DockPanel>
              <DockPanel x:Name="PlotLengthRow" Margin="0,4">
                <TextBlock ui:Tr.Text="A story lasts" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" Width="120" ui:Tr.Value="{Binding PlotLength}" ui:Tr.Count="conversation|conversations"/>
                <Slider Minimum="2" Maximum="20" TickFrequency="1" Value="{Binding PlotLength, Mode=TwoWay}"/>
              </DockPanel>
              <TextBlock x:Name="BondsFooter" Style="{StaticResource Footer}"/>
            </StackPanel>
          </GroupBox>
          <GroupBox ui:Tr.Header="Storylines">
            <StackPanel>
              <CheckBox x:Name="StorylinesToggle" ui:Tr.Content="Each story grows from their whole history" IsChecked="{Binding StorylinesEnabled, Mode=TwoWay}"/>
              <DockPanel x:Name="StoryWordsRow" Margin="0,6,0,4">
                <TextBlock ui:Tr.Text="Their story so far is kept to" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" Width="120" ui:Tr.Value="{Binding StoryWords}" ui:Tr.Count="word|words"/>
                <Slider Minimum="30" Maximum="200" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding StoryWords, Mode=TwoWay}"/>
              </DockPanel>
              <DockPanel x:Name="StoryMomentsRow" Margin="0,4">
                <TextBlock ui:Tr.Text="Latest moments told one by one" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" Text="{Binding StoryMoments}"/>
                <Slider Minimum="2" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding StoryMoments, Mode=TwoWay}"/>
              </DockPanel>
              <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="Every talk, tea party, flower, paper plane, game and cursor grab two characters share is kept. A new story is written from their story so far (a short chronicle, rewritten in the same call) and the latest moments, so it can bring back what happened and never contradicts it. About 300 more tokens per story. With the built-in lines, stories are made from these moments without a model."/>
            </StackPanel>
          </GroupBox>
          <GroupBox x:Name="PlotPromptBox" ui:Tr.Header="The prompt that writes a story">
            <StackPanel>
              <TextBox Text="{Binding PlotPrompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" MinHeight="200"/>
              <Button ui:Tr.Content="Reset Prompt" HorizontalAlignment="Right" Click="ResetPlotPrompt_Click" Margin="0,6,0,0"/>
              <TextBlock x:Name="PlotPromptFooter" Style="{StaticResource Footer}"/>
            </StackPanel>
          </GroupBox>
          <GroupBox ui:Tr.Header="Who lives with whom">
            <StackPanel>
              <TextBlock x:Name="BondsEmpty" ui:Tr.Text="Nobody has shared the screen yet." Foreground="Gray"/>
              <ItemsControl x:Name="BondList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,4">
                      <DockPanel>
                        <Button DockPanel.Dock="Right" ui:Tr.Content="Forget" Tag="{Binding Key}" Click="ForgetBond_Click" FontSize="11" Padding="6,0"/>
                        <Button DockPanel.Dock="Right" ui:Tr.Content="Reset Story" Tag="{Binding Key}" Click="ResetStory_Click" FontSize="11" Padding="6,0" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding Names}" FontWeight="Bold"/>
                      </DockPanel>
                      <TextBlock Text="{Binding Details}" FontSize="11" Foreground="Gray"/>
                      <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Visibility="{Binding SummaryVisibility}"/>
                      <TextBlock Text="{Binding Story}" TextWrapping="Wrap" FontStyle="{Binding StoryStyle}" Foreground="{Binding StoryBrush}" Visibility="{Binding StoryVisibility}"/>
                      <TextBlock Text="{Binding SoFar}" TextWrapping="Wrap" FontSize="11" Foreground="Gray" MaxHeight="48" TextTrimming="CharacterEllipsis" ToolTip="{Binding SoFar}" Visibility="{Binding SoFarVisibility}"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="Time counts while both are on screen, and is kept by name: rename a character and it starts again as a stranger."/>
            </StackPanel>
          </GroupBox>
          <GroupBox ui:Tr.Header="The file">
            <DockPanel>
              <Button DockPanel.Dock="Right" x:Name="ForgetAllBonds" ui:Tr.Content="Forget All" Click="ForgetAllBonds_Click" Margin="8,0,0,0"/>
              <Button DockPanel.Dock="Right" x:Name="ResetAllStories" ui:Tr.Content="Reset All Stories" Click="ResetAllStories_Click" Margin="8,0,0,0"/>
              <Button DockPanel.Dock="Right" ui:Tr.Content="Show in Explorer" Click="RevealBonds_Click"/>
              <TextBlock x:Name="BondsPath" FontSize="11" Foreground="Gray" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </DockPanel>
          </GroupBox>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem ui:Tr.Header="Relationships">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <!-- Two columns, as the Mac's: deeds on the left, memory on the right. Each row's label sits over its slider, so a column has room. -->
        <Grid Margin="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.Resources>
            <Style x:Key="Over" TargetType="TextBlock">
              <Setter Property="TextWrapping" Value="Wrap"/>
              <Setter Property="Margin" Value="0,6,0,0"/>
            </Style>
            <Style x:Key="Shown" TargetType="TextBlock">
              <Setter Property="Width" Value="64"/>
              <Setter Property="TextAlignment" Value="Right"/>
              <Setter Property="VerticalAlignment" Value="Center"/>
              <Setter Property="DockPanel.Dock" Value="Right"/>
            </Style>
          </Grid.Resources>
          <StackPanel Grid.Column="0">
            <GroupBox ui:Tr.Header="Deeds from talk">
              <StackPanel>
                <CheckBox ui:Tr.Content="What they say can turn into what they do" IsChecked="{Binding DeedsEnabled, Mode=TwoWay}"/>
                <UniformGrid Columns="2" Margin="0,6,0,0" IsEnabled="{Binding DeedsEnabled}">
                  <CheckBox ui:Tr.Content="Invite to a game" IsChecked="{Binding DeedGames, Mode=TwoWay}" Margin="0,2"/>
                  <CheckBox ui:Tr.Content="Invite to tea" IsChecked="{Binding DeedTea, Mode=TwoWay}" Margin="0,2"/>
                  <CheckBox ui:Tr.Content="Give a flower" IsChecked="{Binding DeedFlower, Mode=TwoWay}" Margin="0,2"/>
                  <CheckBox ui:Tr.Content="Send a letter" IsChecked="{Binding DeedLetter, Mode=TwoWay}" Margin="0,2"/>
                  <CheckBox ui:Tr.Content="Walk over to someone" IsChecked="{Binding DeedVisit, Mode=TwoWay}" Margin="0,2"/>
                  <CheckBox ui:Tr.Content="Follow someone" IsChecked="{Binding DeedFollow, Mode=TwoWay}" Margin="0,2"/>
                  <CheckBox ui:Tr.Content="Go to sleep" IsChecked="{Binding DeedSleep, Mode=TwoWay}" Margin="0,2"/>
                </UniformGrid>
                <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="A line or a letter may end in a deed: &quot;soccer?&quot; answered &quot;yes&quot; starts the match. Each prompt offers only what is possible right now, and anything else is ignored. About 40 more tokens a line."/>
              </StackPanel>
            </GroupBox>
            <GroupBox ui:Tr.Header="How often" IsEnabled="{Binding DeedsEnabled}">
              <StackPanel>
                <TextBlock ui:Tr.Text="After a deed, the next waits" Style="{StaticResource Over}"/>
                <DockPanel>
                  <TextBlock Style="{StaticResource Shown}" ui:Tr.Value="{Binding DeedGapMinutes}" ui:Tr.Unit=" min" ui:Tr.Zero="no wait"/>
                  <Slider Minimum="0" Maximum="60" TickFrequency="0.5" Value="{Binding DeedGapMinutes, Mode=TwoWay}"/>
                </DockPanel>
                <TextBlock ui:Tr.Text="Most deeds an hour" Style="{StaticResource Over}"/>
                <DockPanel>
                  <TextBlock Style="{StaticResource Shown}" ui:Tr.Value="{Binding DeedsPerHour}" ui:Tr.Zero="no limit"/>
                  <Slider Minimum="0" Maximum="120" TickFrequency="1" Value="{Binding DeedsPerHour, Mode=TwoWay}"/>
                </DockPanel>
                <TextBlock ui:Tr.Text="Same pair, same deed again after" Style="{StaticResource Over}"/>
                <DockPanel>
                  <TextBlock Style="{StaticResource Shown}" ui:Tr.Value="{Binding DeedPairGapMinutes}" ui:Tr.Unit=" min" ui:Tr.Zero="no wait"/>
                  <Slider Minimum="0" Maximum="240" TickFrequency="1" Value="{Binding DeedPairGapMinutes, Mode=TwoWay}"/>
                </DockPanel>
                <TextBlock ui:Tr.Text="An invitation stays open" Style="{StaticResource Over}"/>
                <DockPanel>
                  <TextBlock Style="{StaticResource Shown}" ui:Tr.Value="{Binding InviteOpenMinutes}" ui:Tr.Unit=" min"/>
                  <Slider Minimum="1" Maximum="60" TickFrequency="1" Value="{Binding InviteOpenMinutes, Mode=TwoWay}"/>
                </DockPanel>
                <TextBlock ui:Tr.Text="A yes waits for both to be free" Style="{StaticResource Over}"/>
                <DockPanel>
                  <TextBlock Style="{StaticResource Shown}" ui:Tr.Value="{Binding DeedWaitMinutes}" ui:Tr.Unit=" min"/>
                  <Slider Minimum="0.5" Maximum="15" TickFrequency="0.5" Value="{Binding DeedWaitMinutes, Mode=TwoWay}"/>
                </DockPanel>
                <TextBlock ui:Tr.Text="Following lasts" Style="{StaticResource Over}"/>
                <DockPanel>
                  <TextBlock Style="{StaticResource Shown}" ui:Tr.Value="{Binding FollowSeconds}" ui:Tr.Unit=" s"/>
                  <Slider Minimum="5" Maximum="300" TickFrequency="5" Value="{Binding FollowSeconds, Mode=TwoWay}"/>
                </DockPanel>
                <TextBlock ui:Tr.Text="Built-in letters and talks that invite" Style="{StaticResource Over}"/>
                <DockPanel>
                  <TextBlock Style="{StaticResource Shown}" ui:Tr.Value="{Binding BuiltInInviteShare}" ui:Tr.Unit="%"/>
                  <Slider Minimum="0" Maximum="100" TickFrequency="5" Value="{Binding BuiltInInviteShare, Mode=TwoWay}"/>
                </DockPanel>
                <TextBlock ui:Tr.Text="Built-in answers that say yes" Style="{StaticResource Over}"/>
                <DockPanel>
                  <TextBlock Style="{StaticResource Shown}" ui:Tr.Value="{Binding BuiltInAcceptChance}" ui:Tr.Unit="%"/>
                  <Slider Minimum="0" Maximum="100" TickFrequency="5" Value="{Binding BuiltInAcceptChance, Mode=TwoWay}"/>
                </DockPanel>
                <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="Zero turns a limit off; the same two never do two things within 15 seconds. Without a model each character invites and answers in its own words, close friends saying yes more often."/>
              </StackPanel>
            </GroupBox>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <GroupBox ui:Tr.Header="Long-term memory">
              <StackPanel>
                <CheckBox ui:Tr.Content="Pairs remember each other" IsChecked="{Binding MemoryEnabled, Mode=TwoWay}"/>
                <TextBlock ui:Tr.Text="Memory sent with each line" Style="{StaticResource Over}"/>
                <DockPanel>
                  <TextBlock Style="{StaticResource Shown}" Width="90" ui:Tr.Value="{Binding MemoryTokens}" ui:Tr.Unit=" tokens" ui:Tr.Zero="none"/>
                  <Slider Minimum="0" Maximum="2000" TickFrequency="10" Value="{Binding MemoryTokens, Mode=TwoWay}"/>
                </DockPanel>
                <TextBlock ui:Tr.Text="Facts kept per pair" Style="{StaticResource Over}"/>
                <DockPanel>
                  <TextBlock Style="{StaticResource Shown}" Text="{Binding MemoryFacts}"/>
                  <Slider Minimum="0" Maximum="20" TickFrequency="1" Value="{Binding MemoryFacts, Mode=TwoWay}"/>
                </DockPanel>
                <TextBlock ui:Tr.Text="Days of timeline kept" Style="{StaticResource Over}"/>
                <DockPanel>
                  <TextBlock Style="{StaticResource Shown}" Text="{Binding MemoryDays}"/>
                  <Slider Minimum="0" Maximum="365" TickFrequency="1" Value="{Binding MemoryDays, Mode=TwoWay}"/>
                </DockPanel>
                <CheckBox ui:Tr.Content="The model may note facts as it speaks" IsChecked="{Binding MemoryNotes, Mode=TwoWay}" Margin="0,8,0,0"/>
                <CheckBox ui:Tr.Content="Each knows what it did today" IsChecked="{Binding DayContextEnabled, Mode=TwoWay}" Margin="0,4,0,0"/>
                <TextBlock ui:Tr.Text="Things from today it mentions" Style="{StaticResource Over}" IsEnabled="{Binding DayContextEnabled}"/>
                <DockPanel IsEnabled="{Binding DayContextEnabled}">
                  <TextBlock Style="{StaticResource Shown}" Text="{Binding DayContextItems}"/>
                  <Slider Minimum="0" Maximum="10" TickFrequency="1" Value="{Binding DayContextItems, Mode=TwoWay}"/>
                </DockPanel>
                <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="Every conversation, letter and tea party carries what the two remember, cut to the tokens set here. The timeline is for you; only today and yesterday are sent."/>
              </StackPanel>
            </GroupBox>
            <GroupBox ui:Tr.Header="The diary" IsEnabled="{Binding MemoryEnabled}">
              <StackPanel>
                <CheckBox ui:Tr.Content="At nightfall the model writes their memory down" IsChecked="{Binding DiaryEnabled, Mode=TwoWay}"/>
                <TextBlock ui:Tr.Text="A pair's memory at most every" Style="{StaticResource Over}"/>
                <DockPanel>
                  <TextBlock Style="{StaticResource Shown}" ui:Tr.Value="{Binding DiaryEveryHours}" ui:Tr.Unit=" h"/>
                  <Slider Minimum="1" Maximum="48" TickFrequency="1" Value="{Binding DiaryEveryHours, Mode=TwoWay}"/>
                </DockPanel>
                <TextBlock ui:Tr.Text="Pairs a night" Style="{StaticResource Over}"/>
                <DockPanel>
                  <TextBlock Style="{StaticResource Shown}" Text="{Binding DiaryPairsPerNight}"/>
                  <Slider Minimum="0" Maximum="50" TickFrequency="1" Value="{Binding DiaryPairsPerNight, Mode=TwoWay}"/>
                </DockPanel>
                <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="One call a pair (Costs › Long-term memory): their story, the facts that still matter, the day in a line. Without a model days are counted and facts come from deeds and games."/>
              </StackPanel>
            </GroupBox>
            <GroupBox ui:Tr.Header="Their past" IsEnabled="{Binding MemoryEnabled}">
              <StackPanel>
                <TextBlock ui:Tr.Text="Days read back" Style="{StaticResource Over}"/>
                <DockPanel>
                  <TextBlock Style="{StaticResource Shown}" Text="{Binding SeedDays}"/>
                  <Slider Minimum="1" Maximum="60" TickFrequency="1" Value="{Binding SeedDays, Mode=TwoWay}"/>
                </DockPanel>
                <TextBlock ui:Tr.Text="Lines shown per pair" Style="{StaticResource Over}"/>
                <DockPanel>
                  <TextBlock Style="{StaticResource Shown}" Text="{Binding SeedLines}"/>
                  <Slider Minimum="5" Maximum="200" TickFrequency="5" Value="{Binding SeedLines, Mode=TwoWay}"/>
                </DockPanel>
                <WrapPanel Margin="0,8,0,0">
                  <Button x:Name="SeedCheck" ui:Tr.Content="Check First" Click="SeedCheck_Click" Margin="0,0,6,4" Padding="8,2"/>
                  <Button x:Name="SeedRead" ui:Tr.Content="Read the Past In" Click="SeedRead_Click" Margin="0,0,6,4" Padding="8,2"/>
                  <Button ui:Tr.Content="Open Relationships" Click="OpenRelationships_Click" Margin="0,0,0,4" Padding="8,2"/>
                </WrapPanel>
                <TextBlock x:Name="SeedNews" FontSize="11" Foreground="Gray" TextWrapping="Wrap" Visibility="Collapsed"/>
                <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="Builds each pair's memory from what they said on this PC, one call a pair (Costs › Memory: reading the past); only their own lines are sent. Check First sends nothing. bonds.json is copied first."/>
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </TabItem>
    <TabItem ui:Tr.Header="Calendar">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
          <GroupBox ui:Tr.Header="The day">
            <StackPanel>
              <TextBlock x:Name="CalendarNeedsModel"/>
              <CheckBox x:Name="KnowsTimeToggle" ui:Tr.Content="They know the time of day" IsChecked="{Binding KnowsTimeOfDay, Mode=TwoWay}"/>
              <CheckBox x:Name="KnowsDateToggle" ui:Tr.Content="They know the day of the week and the date" IsChecked="{Binding KnowsDate, Mode=TwoWay}" Margin="0,4,0,0"/>
              <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="Your PC's clock and calendar, told to the model before every line and paper plane: &quot;late evening (22:40)&quot;, &quot;Saturday, 26 September 2026&quot;. This is apart from the colony's own day and night, which only says when they sleep."/>
            </StackPanel>
          </GroupBox>
          <GroupBox ui:Tr.Header="Holidays">
            <StackPanel>
              <CheckBox ui:Tr.Content="Jewish holidays" IsChecked="{Binding JewishHolidays, Mode=TwoWay}"/>
              <CheckBox ui:Tr.Content="Christian holidays" IsChecked="{Binding ChristianHolidays, Mode=TwoWay}" Margin="0,4,0,0"/>
              <CheckBox ui:Tr.Content="Muslim holidays" IsChecked="{Binding MuslimHolidays, Mode=TwoWay}" Margin="0,4,0,0"/>
              <DockPanel x:Name="LookAheadRow" Margin="0,6,0,4">
                <TextBlock ui:Tr.Text="Mention a holiday" Style="{StaticResource RowLabel}"/>
                <TextBlock x:Name="LookAheadValue" Style="{StaticResource RowValue}" Width="110"/>
                <Slider Minimum="0" Maximum="14" TickFrequency="1" Value="{Binding HolidayLookAhead, Mode=TwoWay}"/>
              </DockPanel>
              <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="On a holiday they know it, and which day of it (&quot;day 3 of Sukkot&quot;); before one, how far off it is. Jewish dates come from the Hebrew calendar and Muslim ones from the Islamic (Umm al-Qura) calendar, both built into Windows, so nothing is looked up online; a holiday that starts at sundown &quot;begins this evening&quot; the evening before. Where the new moon is sighted locally, a Muslim date can fall a day apart. With the built-in lines, one conversation in three on a holiday is about it; they only know a holiday on the day, so how far ahead to mention one needs a model."/>
            </StackPanel>
          </GroupBox>
          <GroupBox ui:Tr.Header="What they know right now">
            <StackPanel>
              <TextBlock x:Name="CalendarNow" TextWrapping="Wrap"/>
              <TextBlock x:Name="CalendarNowFooter" Style="{StaticResource Footer}"/>
            </StackPanel>
          </GroupBox>
          <GroupBox ui:Tr.Header="Coming up in the next 60 days">
            <StackPanel>
              <TextBlock x:Name="CalendarAheadEmpty" Foreground="Gray"/>
              <ItemsControl x:Name="CalendarAhead">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,2">
                      <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Foreground="Gray"/>
                      <TextBlock Text="{Binding Name}"/>
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </GroupBox>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <!-- The Tools group: things the creatures do for you, a page each in the sidebar. -->
    <TabItem ui:Tr.Header="Reminders">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
          <GroupBox ui:Tr.Header="New reminder">
            <StackPanel>
              <DockPanel Margin="0,4">
                <TextBlock ui:Tr.Text="Remind me to" Style="{StaticResource RowLabel}"/>
                <Grid>
                  <TextBox x:Name="ReminderText" KeyDown="ReminderText_KeyDown" TextChanged="ReminderText_Changed"/>
                  <TextBlock x:Name="ReminderHint" ui:Tr.Text="Stretch, call mom, stand-up…" Foreground="Gray" IsHitTestVisible="False" Margin="5,0,0,0" VerticalAlignment="Center"/>
                </Grid>
              </DockPanel>
              <DockPanel Margin="0,4">
                <TextBlock ui:Tr.Text="When" Style="{StaticResource RowLabel}"/>
                <TextBox x:Name="ReminderClock" DockPanel.Dock="Right" Width="60" Margin="8,0,0,0" LostFocus="ReminderClock_LostFocus" ui:Tr.ToolTip="Time, 24-hour: 14:30"/>
                <DatePicker x:Name="ReminderDay" SelectedDateChanged="ReminderDay_Changed"/>
              </DockPanel>
              <DockPanel Margin="0,4">
                <TextBlock ui:Tr.Text="Repeat" Style="{StaticResource RowLabel}"/>
                <ComboBox x:Name="ReminderRepeat" DisplayMemberPath="Title"/>
              </DockPanel>
              <DockPanel Margin="0,6,0,0">
                <Button x:Name="AddReminder" DockPanel.Dock="Right" ui:Tr.Content="Add Reminder" Click="AddReminder_Click" IsEnabled="False"/>
                <StackPanel Orientation="Horizontal">
                  <Button ui:Tr.Content="In 5 min" Tag="5" Click="ReminderSoon_Click" Margin="0,0,8,0"/>
                  <Button ui:Tr.Content="In 30 min" Tag="30" Click="ReminderSoon_Click" Margin="0,0,8,0"/>
                  <Button ui:Tr.Content="In 1 hour" Tag="60" Click="ReminderSoon_Click"/>
                </StackPanel>
              </DockPanel>
              <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="When the time comes, one of the creatures folds it into a paper plane and throws it at you. A time already past is delivered straight away. Repeating reminders keep their time of day; weekdays skip Saturday and Sunday."/>
            </StackPanel>
          </GroupBox>
          <GroupBox ui:Tr.Header="Delivery">
            <StackPanel>
              <CheckBox ui:Tr.Content="Reminders arrive by paper plane" IsChecked="{Binding RemindersEnabled, Mode=TwoWay}"/>
              <DockPanel Margin="0,6,0,4">
                <TextBlock ui:Tr.Text="Letter stays open" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" ui:Tr.Value="{Binding ReminderLetterSeconds}" ui:Tr.Unit=" s"/>
                <Slider Minimum="10" Maximum="600" TickFrequency="10" Value="{Binding ReminderLetterSeconds, Mode=TwoWay}"/>
              </DockPanel>
              <CheckBox ui:Tr.Content="The thrower reads its note out loud" IsChecked="{Binding ReminderReadAloud, Mode=TwoWay}"/>
              <CheckBox ui:Tr.Content="Add a Reminder… opens a paper note" IsChecked="{Binding ReminderPaperNote, Mode=TwoWay}" Margin="0,4,0,0"/>
              <Button ui:Tr.Content="Send a Test Letter" Click="TestLetter_Click" HorizontalAlignment="Right" Margin="0,6,0,0"/>
              <TextBlock x:Name="ReminderFooter" Style="{StaticResource Footer}"/>
            </StackPanel>
          </GroupBox>
          <GroupBox ui:Tr.Header="Your reminders">
            <StackPanel>
              <TextBlock x:Name="NoReminders" ui:Tr.Text="No reminders yet." Foreground="Gray"/>
              <ItemsControl x:Name="ReminderList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,4">
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Margin="8,0,0,0"><Hyperlink Tag="{Binding Id}" Click="ReminderSend_Click"><Run ui:Tr.Text="Send Now"/></Hyperlink></TextBlock>
                        <TextBlock Margin="8,0,0,0"><Hyperlink Tag="{Binding Id}" Click="ReminderDelete_Click"><Run ui:Tr.Text="Delete"/></Hyperlink></TextBlock>
                      </StackPanel>
                      <StackPanel Opacity="{Binding Opacity}">
                        <TextBlock Text="{Binding Text}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding When}" FontSize="11" Foreground="Gray"/>
                      </StackPanel>
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="Sent one-off reminders stay here, greyed, until you clear them."/>
            </StackPanel>
          </GroupBox>
          <GroupBox ui:Tr.Header="The file">
            <DockPanel>
              <Button x:Name="ClearSent" DockPanel.Dock="Right" ui:Tr.Content="Clear Sent" Click="ClearSent_Click" Margin="8,0,0,0"/>
              <Button DockPanel.Dock="Right" ui:Tr.Content="Show in Explorer" Click="RevealReminders_Click" Margin="8,0,0,0"/>
              <TextBox x:Name="RemindersPath" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>
            </DockPanel>
          </GroupBox>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem ui:Tr.Header="Clipboard">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
          <CheckBox ui:Tr.Content="Clipboard manager" IsChecked="{Binding ClipboardEnabled, Mode=TwoWay}" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <StackPanel IsEnabled="{Binding ClipboardEnabled}">
            <GroupBox ui:Tr.Header="History">
              <StackPanel>
                <CheckBox ui:Tr.Content="Keep a history of what is copied" IsChecked="{Binding ClipHistoryEnabled, Mode=TwoWay}"/>
                <DockPanel Margin="0,6,0,4">
                  <TextBlock ui:Tr.Text="Copies kept" Style="{StaticResource RowLabel}"/>
                  <TextBlock Style="{StaticResource RowValue}" Text="{Binding ClipHistoryLimit}"/>
                  <Slider Minimum="10" Maximum="2000" TickFrequency="10" Value="{Binding ClipHistoryLimit, Mode=TwoWay}"/>
                </DockPanel>
                <DockPanel Margin="0,4">
                  <TextBlock ui:Tr.Text="Kept for" Style="{StaticResource RowLabel}"/>
                  <TextBlock x:Name="ClipKeepDaysValue" Style="{StaticResource RowValue}"/>
                  <Slider Minimum="0" Maximum="365" TickFrequency="1" Value="{Binding ClipKeepDays, Mode=TwoWay}"/>
                </DockPanel>
                <CheckBox ui:Tr.Content="Keep formatting (rich text)" IsChecked="{Binding ClipKeepFormatting, Mode=TwoWay}"/>
                <CheckBox ui:Tr.Content="Keep files copied in Explorer" IsChecked="{Binding ClipKeepFiles, Mode=TwoWay}" Margin="0,4,0,0"/>
                <CheckBox ui:Tr.Content="Keep images" IsChecked="{Binding ClipKeepImages, Mode=TwoWay}" Margin="0,4,0,0"/>
                <DockPanel Margin="0,4" IsEnabled="{Binding ClipKeepImages}">
                  <TextBlock ui:Tr.Text="Largest image kept" Style="{StaticResource RowLabel}"/>
                  <TextBlock x:Name="ClipLargestImageValue" Style="{StaticResource RowValue}"/>
                  <Slider Minimum="1" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ClipLargestImageMB, Mode=TwoWay}"/>
                </DockPanel>
                <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="Every copy goes into the history, newest first; copying the same thing again moves it to the top. Pinned copies stay whatever the limits say. Pictures count as copies; one bigger than the largest size is left out. Nothing copied ever leaves this PC or reaches a model."/>
              </StackPanel>
            </GroupBox>
            <GroupBox ui:Tr.Header="Pasting">
              <StackPanel>
                <CheckBox ui:Tr.Content="Paste into the app I was in" IsChecked="{Binding ClipAutoPaste, Mode=TwoWay}"/>
                <CheckBox ui:Tr.Content="Paste as plain text" IsChecked="{Binding ClipPlainText, Mode=TwoWay}" Margin="0,4,0,0"/>
                <CheckBox ui:Tr.Content="Unfold and collapse the picker" IsChecked="{Binding ClipAnimate, Mode=TwoWay}" Margin="0,4,0,0"/>
                <DockPanel Margin="0,6,0,4" IsEnabled="{Binding ClipAnimate}">
                  <TextBlock ui:Tr.Text="Animation speed" Style="{StaticResource RowLabel}"/>
                  <TextBlock Style="{StaticResource RowValue}" Text="{Binding ClipAnimationSpeed, StringFormat={}{0:0.##}×}"/>
                  <Slider Minimum="0.5" Maximum="3" TickFrequency="0.25" IsSnapToTickEnabled="True" Value="{Binding ClipAnimationSpeed, Mode=TwoWay}"/>
                </DockPanel>
                <DockPanel Margin="0,4" IsEnabled="{Binding ClipAnimate}">
                  <TextBlock ui:Tr.Text="Who brings it" Style="{StaticResource RowLabel}"/>
                  <ComboBox x:Name="ClipHelperBox" DisplayMemberPath="Title" SelectedValuePath="Name" SelectionChanged="ClipHelper_Changed" Width="240" HorizontalAlignment="Left"/>
                </DockPanel>
                <CheckBox ui:Tr.Content="It says a line as the sheet unfolds" IsChecked="{Binding ClipHelperTalks, Mode=TwoWay}" Margin="0,4,0,0"/>
                <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="Enter pastes, Alt+Enter the other way (plain or formatted). A creature brings the sheet and holds its corner; it collapses into the text cursor and the creature leaps back. The paste never waits."/>
              </StackPanel>
            </GroupBox>
            <GroupBox ui:Tr.Header="Shortcuts">
              <StackPanel>
                <DockPanel Margin="0,2">
                  <CheckBox ui:Tr.Content="History picker" IsChecked="{Binding ClipHistoryShortcutEnabled, Mode=TwoWay}" Width="190" VerticalAlignment="Center"/>
                  <Button x:Name="ClipHistoryShortcutButton" Click="ClipShortcutButton_Click" Tag="history" MinWidth="140" HorizontalAlignment="Left" IsEnabled="{Binding ClipHistoryShortcutEnabled}"/>
                </DockPanel>
                <DockPanel Margin="0,2">
                  <CheckBox ui:Tr.Content="Snippets picker" IsChecked="{Binding ClipSnippetsShortcutEnabled, Mode=TwoWay}" Width="190" VerticalAlignment="Center"/>
                  <Button x:Name="ClipSnippetsShortcutButton" Click="ClipShortcutButton_Click" Tag="snippets" MinWidth="140" HorizontalAlignment="Left" IsEnabled="{Binding ClipSnippetsShortcutEnabled}"/>
                </DockPanel>
                <CheckBox ui:Tr.Content="A snippet's own shortcut pastes it at once" IsChecked="{Binding ClipSnippetShortcutsEnabled, Mode=TwoWay}" Margin="0,4,0,0"/>
                <TextBlock x:Name="ClipShortcutProblemText" Text="{Binding ClipShortcutProblem}" Foreground="DarkOrange" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="They work in every app. In the picker: type to search copies and snippets at once, ↑↓ to choose, Ctrl+1–9 for the first nine, Tab between the groups, Ctrl+P to pin, Delete to forget a copy, Esc to close."/>
              </StackPanel>
            </GroupBox>
            <GroupBox ui:Tr.Header="Snippets">
              <StackPanel>
                <DockPanel>
                  <Button ui:Tr.Content="Edit Snippets…" Click="EditSnippets_Click" DockPanel.Dock="Left"/>
                  <TextBlock x:Name="ClipSnippetCount" Foreground="Gray" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </DockPanel>
                <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="A protected snippet's words live in Windows Credential Manager, never in a file: shown as dots, kept out of the history and taken off the clipboard a second after pasting."/>
              </StackPanel>
            </GroupBox>
            <GroupBox ui:Tr.Header="Never kept">
              <StackPanel>
                <ListBox x:Name="ClipExcludedList" Height="96"/>
                <DockPanel Margin="0,6,0,0">
                  <Button x:Name="ClipClearHistory" DockPanel.Dock="Right" Click="ClipClearHistory_Click"/>
                  <StackPanel Orientation="Horizontal">
                    <Button ui:Tr.Content="Add App…" Click="ClipAddApp_Click" Margin="0,0,8,0"/>
                    <Button ui:Tr.Content="Remove" Click="ClipRemoveApp_Click"/>
                  </StackPanel>
                </DockPanel>
                <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="Nothing copied in these apps is kept, nor anything a password manager marks as secret. Clear History keeps pinned copies."/>
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem ui:Tr.Header="Dictation">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
          <CheckBox ui:Tr.Content="Dictation" IsChecked="{Binding DictationEnabled, Mode=TwoWay}" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <TextBlock x:Name="DictationKeyNote" ui:Tr.Text="Uses the OpenRouter key from Settings › Talk, and none is in use there yet. Without one a creature only says so." Foreground="DarkOrange" TextWrapping="Wrap" Margin="0,0,0,6"/>
          <StackPanel IsEnabled="{Binding DictationEnabled}">
            <GroupBox ui:Tr.Header="Shortcut">
              <StackPanel>
                <DockPanel Margin="0,2">
                  <CheckBox ui:Tr.Content="Start and stop" IsChecked="{Binding DictationShortcutEnabled, Mode=TwoWay}" Width="190" VerticalAlignment="Center"/>
                  <Button x:Name="DictationShortcutButton" Click="DictationShortcutButton_Click" MinWidth="140" HorizontalAlignment="Left" IsEnabled="{Binding DictationShortcutEnabled}"/>
                </DockPanel>
                <CheckBox ui:Tr.Content="Hold to talk" IsChecked="{Binding DictationHoldToTalk, Mode=TwoWay}" Margin="0,4,0,0"/>
                <DockPanel Margin="0,6,0,4">
                  <TextBlock ui:Tr.Text="Longest recording" Style="{StaticResource RowLabel}"/>
                  <TextBlock x:Name="DictationMaxValue" Style="{StaticResource RowValue}"/>
                  <Slider Minimum="10" Maximum="600" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding DictationMaxSeconds, Mode=TwoWay}"/>
                </DockPanel>
                <TextBlock x:Name="DictationShortcutProblemText" Text="{Binding DictationShortcutProblem}" Foreground="DarkOrange" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="Press the shortcut and speak; press it again (or Enter) and the words land on the clipboard and in the clipboard history. Esc lets it go and sends nothing. Holding to talk, it listens while the keys are down. The sound is kept in memory only and never saved."/>
              </StackPanel>
            </GroupBox>
            <GroupBox ui:Tr.Header="Microphone">
              <StackPanel>
                <DockPanel>
                  <Button ui:Tr.Content="Allow…" Click="DictationAllow_Click" DockPanel.Dock="Right"/>
                  <TextBlock x:Name="DictationMicrophoneName" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="Windows lets desktop apps use the microphone unless it is switched off in Settings › Privacy › Microphone; Allow… opens that page. Switched off, a recording is silence."/>
              </StackPanel>
            </GroupBox>
            <GroupBox ui:Tr.Header="Writing it down">
              <StackPanel>
                <DockPanel Margin="0,2">
                  <TextBlock ui:Tr.Text="Model" Style="{StaticResource RowLabel}"/>
                  <ComboBox x:Name="DictationModelBox" DisplayMemberPath="Title" SelectedValuePath="Id" SelectionChanged="DictationModel_Changed"/>
                </DockPanel>
                <TextBlock x:Name="DictationModelsProblem" Foreground="DarkOrange" TextWrapping="Wrap"/>
                <DockPanel Margin="0,4">
                  <TextBlock ui:Tr.Text="Spoken in" Style="{StaticResource RowLabel}"/>
                  <ComboBox x:Name="DictationLanguageBox" DisplayMemberPath="Title" SelectedValuePath="Language" SelectionChanged="DictationLanguage_Changed" Width="240" HorizontalAlignment="Left"/>
                </DockPanel>
                <CheckBox ui:Tr.Content="Tidy it up" IsChecked="{Binding DictationCleanUp, Mode=TwoWay}" Margin="0,4,0,0"/>
                <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="OpenRouter's models that listen to sound, cheapest first; each recording is priced in Settings › Costs as Dictation. Tidying leaves out um and uh, stutters and false starts, and adds punctuation, in the same call."/>
              </StackPanel>
            </GroupBox>
            <GroupBox ui:Tr.Header="The words and the creature">
              <StackPanel>
                <CheckBox ui:Tr.Content="Paste into the app I was in" IsChecked="{Binding DictationPaste, Mode=TwoWay}"/>
                <DockPanel Margin="0,6,0,4">
                  <TextBlock ui:Tr.Text="Who holds the microphone" Style="{StaticResource RowLabel}"/>
                  <ComboBox x:Name="DictationHelperBox" DisplayMemberPath="Title" SelectedValuePath="Name" SelectionChanged="DictationHelper_Changed" Width="240" HorizontalAlignment="Left"/>
                </DockPanel>
                <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="A creature leaps to the middle of the screen holding a microphone whose bars follow your voice, the clock over its head; it thinks while the words are written, says the first of them and hops home."/>
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem ui:Tr.Header="Translate">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
          <CheckBox ui:Tr.Content="Translator" IsChecked="{Binding TranslateEnabled, Mode=TwoWay}" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <TextBlock x:Name="TranslateKeyNote" ui:Tr.Text="Uses the OpenRouter key from Settings › Talk, and none is saved there yet. Without one, and without LM Studio as the brain, the sheet says so." Foreground="DarkOrange" TextWrapping="Wrap" Margin="0,0,0,6"/>
          <StackPanel IsEnabled="{Binding TranslateEnabled}">
            <GroupBox ui:Tr.Header="Translate">
              <StackPanel>
                <DockPanel Margin="0,2">
                  <CheckBox ui:Tr.Content="Type to translate" IsChecked="{Binding TranslateShortcutEnabled, Mode=TwoWay}" Width="220" VerticalAlignment="Center"/>
                  <Button x:Name="TranslateShortcutButton" Click="TranslateShortcutButton_Click" MinWidth="160" HorizontalAlignment="Left" IsEnabled="{Binding TranslateShortcutEnabled}"/>
                </DockPanel>
                <DockPanel Margin="0,2">
                  <CheckBox ui:Tr.Content="Translate the last copy" IsChecked="{Binding TranslateClipShortcutEnabled, Mode=TwoWay}" Width="220" VerticalAlignment="Center"/>
                  <Button x:Name="TranslateClipShortcutButton" Click="TranslateClipShortcutButton_Click" MinWidth="160" HorizontalAlignment="Left" IsEnabled="{Binding TranslateClipShortcutEnabled}"/>
                </DockPanel>
                <DockPanel Margin="0,6,0,2">
                  <TextBlock ui:Tr.Text="The last copy" Style="{StaticResource RowLabel}"/>
                  <ComboBox x:Name="TranslateClipModeBox" DisplayMemberPath="Title" SelectedValuePath="Mode" SelectionChanged="TranslateClipMode_Changed" Width="300" HorizontalAlignment="Left"/>
                </DockPanel>
                <TextBlock Text="{Binding TranslateShortcutProblem}" Foreground="DarkOrange" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="Both work in every app. Type to translate opens the sheet: your words on the left, the translation on the right as you type. The last copy opens in the sheet already translated, or quietly replaces the clipboard with its translation and says so by the text cursor. Enter copies the translation, Ctrl+Enter pastes it into the app you were in."/>
              </StackPanel>
            </GroupBox>
            <GroupBox ui:Tr.Header="Languages">
              <StackPanel>
                <StackPanel x:Name="TranslateLanguageList"/>
                <StackPanel x:Name="TranslateTargetList" Margin="0,6,0,0"/>
                <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="Told apart by their letters, Latin, Cyrillic or Hebrew, on this computer and for free, before anything is sent. A text already in its target goes into the target's own language instead. At least two stay on."/>
              </StackPanel>
            </GroupBox>
            <GroupBox ui:Tr.Header="Model">
              <StackPanel>
                <DockPanel Margin="0,2">
                  <TextBlock ui:Tr.Text="Model" Style="{StaticResource RowLabel}"/>
                  <TextBox Text="{Binding TranslateModel, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                </DockPanel>
                <DockPanel Margin="0,2">
                  <TextBlock ui:Tr.Text="From OpenRouter" Style="{StaticResource RowLabel}"/>
                  <ComboBox x:Name="TranslateModelBox" DisplayMemberPath="Title" SelectedValuePath="Id" SelectionChanged="TranslateModel_Changed"/>
                </DockPanel>
                <TextBlock x:Name="TranslateModelsProblem" Foreground="DarkOrange" TextWrapping="Wrap"/>
                <CheckBox ui:Tr.Content="Guess the rest of the phrase" IsChecked="{Binding TranslateAutocomplete, Mode=TwoWay}" Margin="0,6,0,2"/>
                <DockPanel Margin="0,2" IsEnabled="{Binding TranslateAutocomplete}">
                  <TextBlock ui:Tr.Text="Guess model" Style="{StaticResource RowLabel}"/>
                  <TextBox Text="{Binding TranslateAutocompleteModel, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                </DockPanel>
                <DockPanel Margin="0,6,0,4">
                  <TextBlock ui:Tr.Text="Wait after typing" Style="{StaticResource RowLabel}"/>
                  <TextBlock ui:Tr.Value="{Binding TranslateDelayMs}" ui:Tr.Unit=" ms" Style="{StaticResource RowValue}"/>
                  <Slider Minimum="200" Maximum="1500" TickFrequency="50" Value="{Binding TranslateDelayMs, Mode=TwoWay}"/>
                </DockPanel>
                <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="An OpenRouter model, with the key from Settings › Talk; with LM Studio as the brain and no key, its model, free. Cheap and fast is best: about a cent a day. Every call shows on Costs as Translation, every guess as Autocomplete. Tab takes the grey words. An empty guess model guesses with the translating one."/>
              </StackPanel>
            </GroupBox>
            <GroupBox ui:Tr.Header="Clipboard and safety">
              <StackPanel>
                <CheckBox ui:Tr.Content="Translate button in the clipboard picker" IsChecked="{Binding TranslatePickerButton, Mode=TwoWay}"/>
                <CheckBox ui:Tr.Content="Keep translations in the clipboard history" IsChecked="{Binding TranslateKeepInHistory, Mode=TwoWay}" Margin="0,4,0,0"/>
                <DockPanel Margin="0,6,0,4">
                  <TextBlock ui:Tr.Text="Ask before sending more than" Style="{StaticResource RowLabel}"/>
                  <TextBlock ui:Tr.Value="{Binding TranslateLiveLimit}" ui:Tr.Number="0" Style="{StaticResource RowValue}"/>
                  <Slider Minimum="1000" Maximum="20000" TickFrequency="500" Value="{Binding TranslateLiveLimit, Mode=TwoWay}"/>
                </DockPanel>
                <DockPanel Margin="0,4">
                  <TextBlock ui:Tr.Text="Who brings the sheet" Style="{StaticResource RowLabel}"/>
                  <ComboBox x:Name="TranslateHelperBox" DisplayMemberPath="Title" SelectedValuePath="Name" SelectionChanged="TranslateHelper_Changed" Width="260" HorizontalAlignment="Left"/>
                </DockPanel>
                <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="Text goes to the model only when you translate it. Protected snippets and copies of their words never do, and get no button. Links, e-mails, code and numbers are kept as they are. Longer texts wait for Enter and say their parts and price first; never more than 50 000 characters."/>
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem ui:Tr.Header="Tools screen">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
          <GroupBox ui:Tr.Header="Tools screen">
            <StackPanel>
              <CheckBox ui:Tr.Content="Tools screen" IsChecked="{Binding ToolsScreenEnabled, Mode=TwoWay}" FontWeight="SemiBold"/>
              <DockPanel Margin="0,6,0,2" IsEnabled="{Binding ToolsScreenEnabled}">
                <CheckBox ui:Tr.Content="Open it from any app" IsChecked="{Binding ToolsScreenShortcutEnabled, Mode=TwoWay}" Width="220" VerticalAlignment="Center"/>
                <Button x:Name="ToolsScreenShortcutButton" Click="ToolsScreenShortcutButton_Click" MinWidth="160" HorizontalAlignment="Left" IsEnabled="{Binding ToolsScreenShortcutEnabled}"/>
              </DockPanel>
              <TextBlock Text="{Binding ToolsScreenShortcutProblem}" Foreground="DarkOrange" TextWrapping="Wrap" Margin="0,4,0,0"/>
              <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="Every tool on one sheet, a big picture each: click one, press its number, or choose with the arrows and Enter; Esc closes. The Creature Actions sheet opens it too (K). A tool switched off is greyed, and a click opens the page that switches it on."/>
            </StackPanel>
          </GroupBox>
          <GroupBox ui:Tr.Header="On the screen" IsEnabled="{Binding ToolsScreenEnabled}">
            <StackPanel>
              <StackPanel x:Name="ToolsScreenList"/>
              <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="Move a tool up or down to change the order: the first is 1, the next 2. Switched off here, a tool is not on the screen. Windows has no screenshot tool yet, so no screenshot tiles."/>
            </StackPanel>
          </GroupBox>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem ui:Tr.Header="Voice">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
          <GroupBox ui:Tr.Header="Voice">
            <StackPanel>
              <CheckBox ui:Tr.Content="Hear them talk out loud" IsChecked="{Binding VoiceEnabled, Mode=TwoWay}"/>
              <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock ui:Tr.Text="Voices" Width="70" VerticalAlignment="Center"/>
                <RadioButton x:Name="EngineSystem" ui:Tr.Content="Built-in voices" Checked="Engine_Checked" Margin="0,0,16,0"/>
                <RadioButton x:Name="EngineOr" Content="OpenRouter" Checked="Engine_Checked" Margin="0,0,16,0"/>
                <RadioButton x:Name="EngineLocal" ui:Tr.Content="Local server" Checked="Engine_Checked"/>
              </StackPanel>
              <CheckBox ui:Tr.Content="Every character gets a voice of their own" IsChecked="{Binding VoicePerCharacter, Mode=TwoWay}" Margin="0,6,0,0"/>
              <CheckBox ui:Tr.Content="Cartoon voices: squeakier, sillier" IsChecked="{Binding CartoonVoices, Mode=TwoWay}" Margin="0,4,0,0"/>
              <CheckBox ui:Tr.Content="Voices fit each character's personality" IsChecked="{Binding CastByPersonality, Mode=TwoWay}" Margin="0,4,0,0"/>
              <StackPanel x:Name="SystemVoicePanel" Margin="0,8,0,0">
                <DockPanel>
                  <TextBlock ui:Tr.Text="Voice" Width="70" VerticalAlignment="Center"/>
                  <ComboBox x:Name="SystemVoiceBox" SelectionChanged="SystemVoiceBox_Changed"/>
                </DockPanel>
              </StackPanel>
              <StackPanel x:Name="OrVoicePanel" Margin="0,8,0,0">
                <DockPanel x:Name="VoiceKeyRow" Margin="0,0,0,4">
                  <TextBlock ui:Tr.Text="API key" Width="70" VerticalAlignment="Center"/>
                  <PasswordBox x:Name="VoiceKey" PasswordChanged="VoiceKey_Changed"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,4">
                  <TextBlock ui:Tr.Text="Model" Width="70" VerticalAlignment="Center"/>
                  <ComboBox x:Name="VoiceModelBox" SelectionChanged="VoiceModelBox_Changed"/>
                </DockPanel>
                <DockPanel>
                  <TextBlock ui:Tr.Text="Voice" Width="70" VerticalAlignment="Center"/>
                  <ComboBox x:Name="OrVoiceBox" SelectionChanged="OrVoiceBox_Changed"/>
                </DockPanel>
                <CheckBox ui:Tr.Content="Keep every line it says" IsChecked="{Binding KeepVoices, Mode=TwoWay}" Margin="0,6,0,0"/>
                <DockPanel Margin="0,4,0,0">
                  <TextBlock ui:Tr.Text="Kept" Width="70" VerticalAlignment="Center"/>
                  <Button DockPanel.Dock="Right" ui:Tr.Content="Show in Explorer" Click="RevealVoices_Click"/>
                  <TextBlock x:Name="KeptCount" Foreground="Gray" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock x:Name="VoiceListProblem" Foreground="Red" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,4,0,0"/>
              </StackPanel>
              <StackPanel x:Name="LocalVoicePanel" Margin="0,8,0,0">
                <DockPanel Margin="0,0,0,4">
                  <TextBlock ui:Tr.Text="Server" Width="70" VerticalAlignment="Center"/>
                  <TextBox Text="{Binding LocalVoiceServer, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,4">
                  <TextBlock ui:Tr.Text="Model" Width="70" VerticalAlignment="Center"/>
                  <TextBox Text="{Binding LocalVoiceModel, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <DockPanel>
                  <TextBlock ui:Tr.Text="Voice" Width="70" VerticalAlignment="Center"/>
                  <ComboBox x:Name="LocalVoiceBox" SelectionChanged="LocalVoiceBox_Changed"/>
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                  <Button ui:Tr.Content="Check" Click="LocalCheck_Click" MinWidth="60"/>
                  <Button ui:Tr.Content="Copy Setup Command" Click="CopySetup_Click" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"><Run ui:Tr.Text="Status"/><Run Text=": "/><Run x:Name="LocalCheckStatus" Foreground="Gray"/></TextBlock>
              </StackPanel>
              <StackPanel x:Name="LineVoicePanel" Margin="0,6,0,0">
                <CheckBox ui:Tr.Content="Save the built-in lines' voices" IsChecked="{Binding ReuseLineVoices, Mode=TwoWay}"/>
                <DockPanel Margin="0,4,0,0">
                  <TextBlock ui:Tr.Text="Saved" Width="70" VerticalAlignment="Center"/>
                  <Button DockPanel.Dock="Right" x:Name="ClearLineVoices" ui:Tr.Content="Clear" Click="ClearLineVoices_Click" Margin="8,0,0,0"/>
                  <Button DockPanel.Dock="Right" ui:Tr.Content="Show in Explorer" Click="RevealLineVoices_Click"/>
                  <TextBlock x:Name="SavedCount" Foreground="Gray" VerticalAlignment="Center"/>
                </DockPanel>
              </StackPanel>
              <DockPanel Margin="0,8,0,4">
                <TextBlock ui:Tr.Text="Speed" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" ui:Tr.Value="{Binding VoiceSpeed}" ui:Tr.Number="0.00" ui:Tr.Unit="×"/>
                <Slider Minimum="0.5" Maximum="2" TickFrequency="0.05" Value="{Binding VoiceSpeed, Mode=TwoWay}"/>
              </DockPanel>
              <DockPanel Margin="0,4">
                <TextBlock ui:Tr.Text="Pitch" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" ui:Tr.Value="{Binding VoicePitch}" ui:Tr.Number="0.00" ui:Tr.Unit="×"/>
                <Slider Minimum="0.5" Maximum="2" TickFrequency="0.05" Value="{Binding VoicePitch, Mode=TwoWay}"/>
              </DockPanel>
              <CheckBox ui:Tr.Content="Speed follows pitch: no echo, higher talks a little faster" IsChecked="{Binding SpeedFollowsPitch, Mode=TwoWay}" Margin="0,4"/>
              <DockPanel Margin="0,4">
                <TextBlock ui:Tr.Text="Pause before the answer" Style="{StaticResource RowLabel}" Width="150"/>
                <TextBlock Style="{StaticResource RowValue}" ui:Tr.Value="{Binding VoiceTurnPause}" ui:Tr.Number="0.00" ui:Tr.Unit=" s"/>
                <Slider Minimum="0" Maximum="2" TickFrequency="0.05" Value="{Binding VoiceTurnPause, Mode=TwoWay}"/>
              </DockPanel>
              <DockPanel Margin="0,4">
                <TextBlock ui:Tr.Text="Volume" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" ui:Tr.Value="{Binding VoiceVolume}" ui:Tr.Number="0.00"/>
                <Slider Minimum="0" Maximum="1" TickFrequency="0.05" Value="{Binding VoiceVolume, Mode=TwoWay}"/>
              </DockPanel>
              <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button ui:Tr.Content="Test" Click="VoiceTest_Click" MinWidth="60"/>
                <Button ui:Tr.Content="Stop" Click="VoiceStop_Click" MinWidth="60" Margin="8,0,0,0"/>
              </StackPanel>
              <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"><Run ui:Tr.Text="Status"/><Run Text=": "/><Run x:Name="VoiceStatus" Foreground="Gray"/></TextBlock>
              <TextBlock x:Name="VoiceFooter" Style="{StaticResource Footer}"/>
            </StackPanel>
          </GroupBox>
          <GroupBox ui:Tr.Header="Characters">
            <StackPanel>
              <TextBlock x:Name="NoVoiceCharacters" ui:Tr.Text="Nobody on screen right now." Foreground="Gray"/>
              <StackPanel x:Name="CharacterVoiceList"/>
              <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button x:Name="CastEveryone" ui:Tr.Content="Cast Everyone with Model" Click="CastEveryone_Click"/>
              </StackPanel>
              <TextBlock x:Name="VoiceNeedsModel" Margin="0,6,0,0"/>
              <TextBlock x:Name="CastAllNote" FontSize="11" Foreground="Gray" TextWrapping="Wrap" Visibility="Collapsed"/>
              <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="The characters on screen now. Each starts automatic: with &quot;Voices fit each character's personality&quot; on, their description and species choose the voice, pitch and speed (old and slow, tiny and quick, a robot, a ghost…); off, voices are only handed out to differ. &quot;Cast with Model&quot; asks the brain model instead, which understands any description, and keeps its choice as the character's own; it costs one call. A voice picked here is theirs alone; the automatic ones go round it. Speed and Pitch here multiply the overall sliders above; Speed follows pitch can be set for one character alone. &quot;Auto&quot; puts a character back to automatic. Settings follow the name, on every engine; an OpenRouter voice the chosen model does not have is ignored. With the Local server, &quot;Custom blend…&quot; mixes Kokoro voices, af_bella(2)+am_puck(1) being two parts Bella to one of Puck: endless voices from the 72, free. OpenRouter's Kokoro refuses blends."/>
            </StackPanel>
          </GroupBox>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem ui:Tr.Header="Costs">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
          <GroupBox ui:Tr.Header="Spent">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="100"/><ColumnDefinition Width="90"/><ColumnDefinition Width="60"/><ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="1" ui:Tr.Text="Cost" FontSize="11" Foreground="Gray"/>
                <TextBlock Grid.Row="0" Grid.Column="2" ui:Tr.Text="Calls" FontSize="11" Foreground="Gray"/>
                <TextBlock Grid.Row="0" Grid.Column="3" ui:Tr.Text="Tokens" FontSize="11" Foreground="Gray"/>
                <TextBlock Grid.Row="1" Grid.Column="0" ui:Tr.Text="Today"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TodayCost"/><TextBlock Grid.Row="1" Grid.Column="2" x:Name="TodayCalls"/><TextBlock Grid.Row="1" Grid.Column="3" x:Name="TodayTokens"/>
                <TextBlock Grid.Row="2" Grid.Column="0" ui:Tr.Text="This month"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="MonthCost"/><TextBlock Grid.Row="2" Grid.Column="2" x:Name="MonthCalls"/><TextBlock Grid.Row="2" Grid.Column="3" x:Name="MonthTokens"/>
                <TextBlock Grid.Row="3" Grid.Column="0" ui:Tr.Text="All time"/>
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="AllCost"/><TextBlock Grid.Row="3" Grid.Column="2" x:Name="AllCalls"/><TextBlock Grid.Row="3" Grid.Column="3" x:Name="AllTokens"/>
              </Grid>
              <TextBlock x:Name="SpendFooter" Style="{StaticResource Footer}"/>
            </StackPanel>
          </GroupBox>
          <GroupBox ui:Tr.Header="By feature">
            <StackPanel>
              <TextBlock x:Name="NoPurposes" ui:Tr.Text="Nothing yet." Foreground="Gray"/>
              <ItemsControl x:Name="SpendPurposes">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,1"><TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Foreground="Gray"/><TextBlock Text="{Binding Name}"/></DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="Talk is the meetings and pokes (two calls a conversation); paper planes the notes and the catcher's thought; voice every line said by a paid speech model; voice casting each Cast with Model; relationship plots one call per story a pair gets (Bonds tab). Calls from before features were labelled are counted apart."/>
            </StackPanel>
          </GroupBox>
          <GroupBox ui:Tr.Header="By model">
            <ItemsControl x:Name="SpendModels">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,1"><TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" FontSize="11" Foreground="Gray"/><TextBlock Text="{Binding Name}" FontSize="11"/></DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </GroupBox>
          <GroupBox ui:Tr.Header="Latest calls">
            <StackPanel>
              <TextBlock x:Name="NoCalls" ui:Tr.Text="No calls yet." Foreground="Gray"/>
              <ItemsControl x:Name="RecentCalls">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,2">
                      <TextBlock DockPanel.Dock="Right" Text="{Binding Cost}" Foreground="{Binding CostBrush}" VerticalAlignment="Center"/>
                      <StackPanel>
                        <TextBlock Text="{Binding Model}" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="Gray"/>
                      </StackPanel>
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock x:Name="RecentFooter" Style="{StaticResource Footer}"/>
            </StackPanel>
          </GroupBox>
          <GroupBox ui:Tr.Header="The file">
            <StackPanel>
              <DockPanel>
                <Button DockPanel.Dock="Right" ui:Tr.Content="Show in Explorer" Click="RevealSpend_Click"/>
                <TextBlock x:Name="SpendPath" FontSize="11" Foreground="Gray" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
              </DockPanel>
              <TextBlock Style="{StaticResource Footer}" ui:Tr.Text="spend.jsonl, one JSON line per call: time, provider, model, feature, tokens and cost. Plain text on purpose."/>
            </StackPanel>
          </GroupBox>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem ui:Tr.Header="Chats">
      <DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="10">
          <Button DockPanel.Dock="Right" ui:Tr.Content="Open in Terminal" Click="OpenTerminal_Click" Margin="8,0,0,0"/>
          <Button DockPanel.Dock="Right" ui:Tr.Content="Open in Explorer" Click="OpenChats_Click"/>
          <TextBlock x:Name="ChatsPath" FontSize="11" Foreground="Gray" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </DockPanel>
        <ListBox DockPanel.Dock="Left" x:Name="DayList" Width="150" SelectionChanged="DayList_Changed" DisplayMemberPath="Title"/>
        <Grid>
          <TextBlock x:Name="ChatsEmpty" Foreground="Gray" TextWrapping="Wrap" TextAlignment="Center" Margin="24" VerticalAlignment="Center"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ExchangeList" Margin="12">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,0,14">
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="{Binding Cost}" FontSize="11" Foreground="Gray" Margin="8,0,0,0"/>
                        <TextBlock Text="{Binding Tokens}" FontSize="11" Foreground="Gray" Margin="8,0,0,0"/>
                        <TextBlock Text="{Binding Voice}" ToolTip="{Binding VoiceModels}" FontSize="11" Foreground="Gray" Margin="8,0,0,0"/>
                      </StackPanel>
                      <TextBlock Text="{Binding Time}" FontSize="11" Foreground="Gray"/>
                      <TextBlock Text="{Binding Model}" FontSize="11" Foreground="Gray" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Situation}" FontSize="11" Foreground="DarkGray" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Plot}" Visibility="{Binding PlotVisibility}" FontSize="11" FontStyle="Italic" Foreground="DarkGray" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding Lines}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <TextBlock TextWrapping="Wrap" ui:StyledLine.Line="{Binding}"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </DockPanel>
    </TabItem>
  </TabControl>
    </DockPanel>
  </Grid>
</Window>
