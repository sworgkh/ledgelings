<Window x:Class="Ledgelings.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Ledgelings.UI"
        Title="Ledgelings Settings" Width="620" Height="700" MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
  <Window.Resources>
    <ui:ZeroAsText x:Key="ZeroAsText"/>
    <Style x:Key="Footer" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="Gray"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>
    <Style x:Key="RowLabel" TargetType="TextBlock">
      <Setter Property="Width" Value="110"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="RowValue" TargetType="TextBlock">
      <Setter Property="Width" Value="70"/>
      <Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="DockPanel.Dock" Value="Right"/>
    </Style>
    <Style TargetType="GroupBox">
      <Setter Property="Padding" Value="8"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style TargetType="Slider">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="IsSnapToTickEnabled" Value="True"/>
    </Style>
  </Window.Resources>
  <TabControl x:Name="Tabs">
    <TabItem Header="Creatures">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
          <GroupBox Header="Creatures">
            <StackPanel>
              <DockPanel Margin="0,4">
                <TextBlock Text="How many" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" Text="{Binding CreatureCount}"/>
                <Slider Minimum="1" Maximum="24" TickFrequency="1" Value="{Binding CreatureCount, Mode=TwoWay}"/>
              </DockPanel>
              <DockPanel Margin="0,4">
                <TextBlock Text="Smallest" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" Text="{Binding MinSize, StringFormat={}{0}×}"/>
                <Slider Minimum="1" Maximum="5" TickFrequency="0.5" Value="{Binding MinSize, Mode=TwoWay}"/>
              </DockPanel>
              <DockPanel Margin="0,4">
                <TextBlock Text="Largest" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" Text="{Binding MaxSize, StringFormat={}{0}×}"/>
                <Slider Minimum="1" Maximum="5" TickFrequency="0.5" Value="{Binding MaxSize, Mode=TwoWay}"/>
              </DockPanel>
              <TextBlock Style="{StaticResource Footer}" Text="Every creature gets its own size between the two. Set them equal and they all match. On a high-dpi monitor the sizes scale with it, so 3× is the same size as on a Mac."/>
            </StackPanel>
          </GroupBox>
          <GroupBox Header="Colours">
            <StackPanel>
              <ItemsControl x:Name="ColourList">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Width="36" Height="36" Margin="4" Background="{Binding Brush}" Tag="{Binding Index}" ToolTip="{Binding Hex}" Click="Colour_Click" BorderBrush="Gray"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <DockPanel Margin="0,6,0,0">
                <Button DockPanel.Dock="Right" Content="Reset" Click="ResetColours_Click"/>
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="AddColour" Content="Add Colour" Click="AddColour_Click" Margin="0,0,8,0"/>
                  <Button x:Name="RemoveColour" Content="Remove Last" Click="RemoveColour_Click"/>
                </StackPanel>
              </DockPanel>
              <TextBlock Style="{StaticResource Footer}" Text="Creature 1 wears the first colour, creature 2 the second, and so on, starting over when the colours run out. Click a swatch to change it."/>
            </StackPanel>
          </GroupBox>
          <GroupBox Header="Tea parties">
            <StackPanel>
              <CheckBox Content="Sit down to tea now and then" IsChecked="{Binding TeaPartiesEnabled, Mode=TwoWay}"/>
              <DockPanel Margin="0,6,0,4" IsEnabled="{Binding TeaPartiesEnabled}">
                <TextBlock Text="Share of bumps" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" Text="{Binding TeaPartyChance, StringFormat={}{0}%}"/>
                <Slider Minimum="1" Maximum="100" TickFrequency="1" Value="{Binding TeaPartyChance, Mode=TwoWay}"/>
              </DockPanel>
              <DockPanel Margin="0,4" IsEnabled="{Binding TeaPartiesEnabled}">
                <TextBlock Text="Lasts" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" Text="{Binding TeaPartyMinutes, StringFormat={}{0} min}"/>
                <Slider Minimum="1" Maximum="10" TickFrequency="0.5" Value="{Binding TeaPartyMinutes, Mode=TwoWay}"/>
              </DockPanel>
              <DockPanel Margin="0,4" IsEnabled="{Binding TeaPartiesEnabled}">
                <TextBlock Text="Sip between stories" Style="{StaticResource RowLabel}" Width="130"/>
                <TextBlock Style="{StaticResource RowValue}" Text="{Binding TeaSipSeconds, StringFormat={}{0} s}"/>
                <Slider Minimum="0" Maximum="30" TickFrequency="1" Value="{Binding TeaSipSeconds, Mode=TwoWay}"/>
              </DockPanel>
              <TextBlock Style="{StaticResource Footer}" Text="Now and then two creatures who bump into each other put a little table out between them and sit down to tea, taking turns to tell each other stories from their lives. One party at a time. With talk off they just sip."/>
            </StackPanel>
          </GroupBox>
          <GroupBox Header="Day and night">
            <StackPanel>
              <DockPanel Margin="0,4">
                <TextBlock Text="Day lasts" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" Text="{Binding DayMinutes, StringFormat={}{0} min}"/>
                <Slider Minimum="0.5" Maximum="60" TickFrequency="0.5" Value="{Binding DayMinutes, Mode=TwoWay}"/>
              </DockPanel>
              <DockPanel Margin="0,4">
                <TextBlock Text="Night lasts" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" Text="{Binding NightMinutes, Converter={StaticResource ZeroAsText}, ConverterParameter=never}"/>
                <Slider Minimum="0" Maximum="60" TickFrequency="0.5" Value="{Binding NightMinutes, Mode=TwoWay}"/>
              </DockPanel>
              <TextBlock Style="{StaticResource Footer}" Text="They walk by day and sleep by night. Set the night to 0 and they never sleep. A cursor still startles a sleeper awake."/>
            </StackPanel>
          </GroupBox>
          <GroupBox Header="Patience">
            <StackPanel>
              <CheckBox Content="Complain when pushed around" IsChecked="{Binding ComplainEnabled, Mode=TwoWay}"/>
              <DockPanel Margin="0,6,0,4" IsEnabled="{Binding ComplainEnabled}">
                <TextBlock Text="Puts up with" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" Text="{Binding ComplainAfter, StringFormat={}{0} in a row}"/>
                <Slider Minimum="1" Maximum="20" TickFrequency="1" Value="{Binding ComplainAfter, Mode=TwoWay}"/>
              </DockPanel>
              <DockPanel Margin="0,4" IsEnabled="{Binding ComplainEnabled}">
                <TextBlock Text="Calms down after" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" Text="{Binding ComplainCalmSeconds, StringFormat={}{0} s}"/>
                <Slider Minimum="5" Maximum="120" TickFrequency="5" Value="{Binding ComplainCalmSeconds, Mode=TwoWay}"/>
              </DockPanel>
              <TextBlock Style="{StaticResource Footer}" Text="Chase a creature with the cursor or pick it up more than this many times in a row, and it tells you off in its own voice. Leave it alone this long and it starts counting again."/>
            </StackPanel>
          </GroupBox>
          <GroupBox Header="Creature Actions">
            <StackPanel>
              <CheckBox Content="Keep the sheet up after an action" IsChecked="{Binding ActionsStayOpen, Mode=TwoWay}"/>
              <TextBlock Style="{StaticResource Footer}" Text="The tray's Creature Actions… opens a sheet of pictures, one for everything you can ask of them. On, it stays up for another go until you press Done; off, it folds away after one."/>
            </StackPanel>
          </GroupBox>
          <GroupBox Header="Startup">
            <StackPanel>
              <CheckBox x:Name="StartAtLogin" Content="Start Ledgelings when you log in" Checked="StartAtLogin_Changed" Unchecked="StartAtLogin_Changed"/>
              <TextBlock Margin="0,4,0,0"><Run Text="Status: "/><Run x:Name="LoginStatus" Text="not checked" Foreground="Gray"/></TextBlock>
              <TextBlock Style="{StaticResource Footer}" Text="Uses the per-user Startup list; Task Manager › Startup apps shows it too."/>
            </StackPanel>
          </GroupBox>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Sprites">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
          <GroupBox Header="Creatures">
            <StackPanel>
              <ItemsControl x:Name="SpeciesList">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="5" Padding="8" CornerRadius="10" BorderThickness="2" Width="118" Cursor="Hand"
                            BorderBrush="{Binding Border}" Background="{Binding Fill}" Tag="{Binding Name}" MouseLeftButtonUp="Species_Click">
                      <StackPanel>
                        <Grid>
                          <Image Source="{Binding Image}" Width="96" Height="96" RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True"/>
                          <TextBlock Text="{Binding Check}" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="18" Foreground="{Binding Border}"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                          <TextBlock Text="{Binding Name}" FontWeight="{Binding Weight}"/>
                          <Button Content="🗑" Visibility="{Binding DeleteVisibility}" Tag="{Binding Name}" Click="Species_Delete"
                                  Margin="6,0,0,0" Padding="4,0" BorderThickness="0" Background="Transparent" ToolTip="Delete this imported creature"/>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <DockPanel Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal">
                  <Button Content="Import Sheet…" Click="ImportSheet_Click" Margin="0,0,8,0"/>
                  <Button Content="Open Folder" Click="OpenSpritesFolder_Click"/>
                </StackPanel>
                <TextBlock x:Name="SpriteStatus" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="Gray" TextWrapping="Wrap" FontSize="11"/>
              </DockPanel>
              <TextBlock x:Name="SpritesFooter" Style="{StaticResource Footer}"/>
            </StackPanel>
          </GroupBox>
          <GroupBox Header="Sprite kit">
            <StackPanel>
              <TextBlock TextWrapping="Wrap" Text="Copy the prompt, paste it into any chat model, replace the placeholder with a description of the creature you want, and save the model's answer as a .txt file. Then Import Sheet…"/>
              <StackPanel Orientation="Horizontal" Margin="0,8">
                <Button x:Name="CopyPrompt" Content="Copy Prompt" Click="CopyPrompt_Click"/>
                <Button Content="Save Example Sheet…" Click="SaveExample_Click" Margin="8,0,0,0"/>
                <Button Content="Save PNG Template…" Click="SaveTemplate_Click" Margin="8,0,0,0"/>
              </StackPanel>
              <TextBox x:Name="PromptBox" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Height="220" VerticalScrollBarVisibility="Auto"/>
              <TextBlock Style="{StaticResource Footer}" Text="The example sheet is the built-in creature written in the same letters: a good thing to show the model, or to edit by hand. The PNG template marks the cells and the body box for an image model or a paint program; the app cuts the magenta away on import."/>
            </StackPanel>
          </GroupBox>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Talk">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
          <GroupBox Header="Talking">
            <StackPanel>
              <CheckBox Content="Creatures talk when they bump into each other" IsChecked="{Binding TalkEnabled, Mode=TwoWay}"/>
              <DockPanel Margin="0,6,0,4">
                <TextBlock Text="Bubble stays" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" Text="{Binding BubbleSeconds, StringFormat={}{0} s}"/>
                <Slider Minimum="4" Maximum="60" TickFrequency="1" Value="{Binding BubbleSeconds, Mode=TwoWay}"/>
              </DockPanel>
              <DockPanel Margin="0,4">
                <TextBlock Text="Not repeating their last" Style="{StaticResource RowLabel}" Width="150"/>
                <TextBlock x:Name="LineMemoryValue" Style="{StaticResource RowValue}"/>
                <Slider Minimum="0" Maximum="40" TickFrequency="1" Value="{Binding LineMemory, Mode=TwoWay}"/>
              </DockPanel>
              <CheckBox Content="Paper planes" IsChecked="{Binding PlanesEnabled, Mode=TwoWay}" Margin="0,4,0,0"/>
              <DockPanel Margin="0,6,0,4" IsEnabled="{Binding PlanesEnabled}">
                <TextBlock Text="A paper plane every" Style="{StaticResource RowLabel}" Width="130"/>
                <TextBlock Style="{StaticResource RowValue}" Text="{Binding PlaneMinutes, StringFormat={}{0} min}"/>
                <Slider Minimum="0.5" Maximum="60" TickFrequency="0.5" Value="{Binding PlaneMinutes, Mode=TwoWay}"/>
              </DockPanel>
              <TextBlock Style="{StaticResource Footer}" Text="Two creatures meeting on the same edge trade a line and a reply. Every third meeting of a pair, one gives the other a flower (the Flowers tab). Every so often one folds a note into a paper plane and throws it to another; its own wind swirls it across the screen, the catcher reads it out, thinks aloud about it and throws one answer back. &quot;Make Someone Talk&quot; and &quot;Send a Paper Plane&quot; in the menu work at any time. Longer lines stay up a little longer; a click on a bubble closes it. Each creature remembers its last lines and says something else until it has run through the rest; a model is shown them and asked for something new."/>
            </StackPanel>
          </GroupBox>
          <GroupBox Header="Brain">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="BrainScript" Content="Built-in lines" Checked="Brain_Checked" Margin="0,0,16,0"/>
                <RadioButton x:Name="BrainLm" Content="LM Studio" Checked="Brain_Checked" Margin="0,0,16,0"/>
                <RadioButton x:Name="BrainOr" Content="OpenRouter" Checked="Brain_Checked"/>
              </StackPanel>
              <StackPanel x:Name="ScriptPanel" Margin="0,8,0,0">
                <TextBox x:Name="ScriptBox" Text="{Binding Script, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="NoWrap"
                         FontFamily="Consolas" FontSize="12" Height="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"><Run Text="Status: "/><Run x:Name="ScriptStatus" Foreground="Gray"/></TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                  <Button Content="Import…" Click="ScriptImport_Click"/>
                  <Button Content="Export…" Click="ScriptExport_Click" Margin="8,0,0,0"/>
                  <Button x:Name="CopyAgentPrompt" Content="Copy Agent Prompt" Click="CopyAgentPrompt_Click" Margin="8,0,0,0"/>
                  <Button Content="Reset Lines" Click="ScriptReset_Click" Margin="8,0,0,0"/>
                </StackPanel>
              </StackPanel>
              <StackPanel x:Name="LmPanel" Margin="0,8,0,0">
                <DockPanel>
                  <TextBlock Text="Server" Width="70" VerticalAlignment="Center"/>
                  <TextBox Text="{Binding TalkServer, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <DockPanel Margin="0,4">
                  <TextBlock Text="Model" Width="70" VerticalAlignment="Center"/>
                  <Button DockPanel.Dock="Right" Content="Check" Click="LmCheck_Click" Margin="8,0,0,0" MinWidth="60"/>
                  <ComboBox DockPanel.Dock="Right" x:Name="LmInstalled" Width="140" Margin="8,0,0,0" Visibility="Collapsed" SelectionChanged="LmInstalled_Changed" ToolTip="Installed models"/>
                  <TextBox Text="{Binding TalkModel, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"><Run Text="Status: "/><Run x:Name="LmStatus" Text="not checked" Foreground="Gray"/></TextBlock>
              </StackPanel>
              <StackPanel x:Name="OrPanel" Margin="0,8,0,0">
                <DockPanel>
                  <TextBlock Text="API key" Width="70" VerticalAlignment="Center"/>
                  <PasswordBox x:Name="OrKey" PasswordChanged="OrKey_Changed"/>
                </DockPanel>
                <DockPanel Margin="0,4">
                  <TextBlock Text="Model" Width="70" VerticalAlignment="Center"/>
                  <Button DockPanel.Dock="Right" Content="Check" Click="OrCheck_Click" Margin="8,0,0,0" MinWidth="60"/>
                  <TextBox Text="{Binding OpenRouterModel, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"><Run Text="Status: "/><Run x:Name="OrStatus" Text="not checked" Foreground="Gray"/></TextBlock>
                <DockPanel Margin="0,8,0,4">
                  <Button DockPanel.Dock="Right" Content="↻" Click="ReloadCatalog_Click" ToolTip="Fetch the list again" Margin="8,0,0,0" MinWidth="28"/>
                  <TextBox x:Name="ModelSearch" TextChanged="ModelSearch_Changed" ToolTip="e.g. flash lite, gemma, free"/>
                </DockPanel>
                <ListBox x:Name="ModelList" Height="220" SelectionChanged="ModelList_Changed" HorizontalContentAlignment="Stretch">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Price}" Foreground="{Binding PriceBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <StackPanel>
                          <TextBlock Text="{Binding Id}" FontFamily="Consolas"/>
                          <TextBlock Text="{Binding Name}" FontSize="11" Foreground="Gray" Visibility="{Binding NameVisibility}"/>
                        </StackPanel>
                      </DockPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="CatalogStatus" FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0"/>
              </StackPanel>
              <DockPanel x:Name="LineTokensRow" Margin="0,8,0,0">
                <TextBlock Text="Room for each line" Style="{StaticResource RowLabel}" Width="130"/>
                <TextBlock Style="{StaticResource RowValue}" Width="90" Text="{Binding LineTokens, StringFormat={}{0} tokens}"/>
                <Slider Minimum="100" Maximum="4000" TickFrequency="100" Value="{Binding LineTokens, Mode=TwoWay}"/>
              </DockPanel>
              <TextBlock x:Name="BrainFooter" Style="{StaticResource Footer}"/>
            </StackPanel>
          </GroupBox>
          <GroupBox Header="Characters">
            <StackPanel>
              <DockPanel>
                <TextBlock Text="Species" Width="70" VerticalAlignment="Center"/>
                <ComboBox x:Name="CastSpecies" SelectionChanged="CastSpecies_Changed"/>
              </DockPanel>
              <TextBlock x:Name="CastKind" FontSize="11" Foreground="Gray" Margin="0,4"/>
              <ItemsControl x:Name="CastList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,4">
                      <DockPanel>
                        <Button DockPanel.Dock="Right" Content="−" Tag="{Binding Index}" Click="CastRemove_Click" Width="24" ToolTip="Remove this character"/>
                        <TextBox Text="{Binding Name, Mode=OneWay}" FontWeight="Bold" Tag="{Binding Index}" LostFocus="CastName_Changed" Margin="0,0,4,0"/>
                      </DockPanel>
                      <TextBox Text="{Binding Persona, Mode=OneWay}" TextWrapping="Wrap" AcceptsReturn="True" Tag="{Binding Index}" LostFocus="CastPersona_Changed" Margin="0,2,28,0"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <DockPanel Margin="0,6,0,0">
                <Button DockPanel.Dock="Right" Content="Reset Cast" Click="CastReset_Click"/>
                <Button Content="Add Character" Click="CastAdd_Click" HorizontalAlignment="Left"/>
              </DockPanel>
              <TextBlock Style="{StaticResource Footer}" Text="Every species has its own cast. The first creature wearing a species is its first character, the second its second, and so on, starting over when the cast runs out. The species itself is described to the model, so a frog talks like a frog."/>
            </StackPanel>
          </GroupBox>
          <GroupBox x:Name="PromptsBox" Header="Prompts">
            <StackPanel>
              <TextBlock Text="Who is speaking (system prompt)" FontWeight="SemiBold"/>
              <TextBox Text="{Binding SystemPrompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" MinHeight="72" Margin="0,2,0,8"/>
              <TextBlock Text="Opening line" FontWeight="SemiBold"/>
              <TextBox Text="{Binding LinePrompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" MinHeight="48" Margin="0,2,0,8"/>
              <TextBlock Text="Reply" FontWeight="SemiBold"/>
              <TextBox Text="{Binding ReplyPrompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" MinHeight="60" Margin="0,2,0,8"/>
              <Button Content="Reset Prompts" HorizontalAlignment="Right" Click="ResetPrompts_Click"/>
              <TextBlock x:Name="PromptFooter" Style="{StaticResource Footer}"/>
            </StackPanel>
          </GroupBox>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Flowers">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
          <GroupBox Header="Wearing">
            <StackPanel>
              <DockPanel Margin="0,4">
                <TextBlock Text="Flower lasts" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" Text="{Binding FlowerMinutes, StringFormat={}{0} min}"/>
                <Slider Minimum="0.5" Maximum="30" TickFrequency="0.5" Value="{Binding FlowerMinutes, Mode=TwoWay}"/>
              </DockPanel>
              <CheckBox Content="The one with the flower follows the giver while it lasts" IsChecked="{Binding FollowGiver, Mode=TwoWay}"/>
              <TextBlock Style="{StaticResource Footer}" Text="Every third meeting of a pair, one gives the other a flower, worn on the head until it wilts or is planted. With the box ticked, the wearer trails the giver around the edge meanwhile. A creature wearing a flower walks past everyone without bumping."/>
            </StackPanel>
          </GroupBox>
          <GroupBox Header="Planting">
            <StackPanel>
              <CheckBox Content="They plant their flowers where they like" IsChecked="{Binding PlantFlowers, Mode=TwoWay}"/>
              <DockPanel Margin="0,6,0,4" IsEnabled="{Binding PlantFlowers}">
                <TextBlock Text="A planted flower lasts" Style="{StaticResource RowLabel}" Width="180"/>
                <TextBlock Style="{StaticResource RowValue}" Text="{Binding GardenMinutes, StringFormat={}{0} min}"/>
                <Slider Minimum="1" Maximum="240" TickFrequency="1" Value="{Binding GardenMinutes, Mode=TwoWay}"/>
              </DockPanel>
              <DockPanel Margin="0,4" IsEnabled="{Binding PlantFlowers}">
                <TextBlock Text="Flowers in the ground at most" Style="{StaticResource RowLabel}" Width="180"/>
                <TextBlock Style="{StaticResource RowValue}" Text="{Binding GardenSize}"/>
                <Slider Minimum="1" Maximum="40" TickFrequency="1" Value="{Binding GardenSize, Mode=TwoWay}"/>
              </DockPanel>
              <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="Clear Planted Flowers" Click="ClearGarden_Click"/>
                <TextBlock x:Name="GardenCleared" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="Gray"/>
              </StackPanel>
              <TextBlock Style="{StaticResource Footer}" Text="After wearing it a while, each one stops following its giver, goes looking for the kind of spot its character likes and plants the flower in the edge there. What it likes comes from who it is: Blocky wants the bottom edge, Pip the ceiling, Ruth a neat row beside the others, Dot plants at once, Zed waits for dark. If nowhere suits before the flower would wilt, it plants it where it stands. Planting one more than the most wilts the oldest. Clear Planted Flowers, here or in the menu, pulls them all up at once. Planted flowers are not kept when the app quits."/>
            </StackPanel>
          </GroupBox>
          <GroupBox Header="Who plants where">
            <StackPanel>
              <ItemsControl x:Name="PlanterList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,3">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Width="110" VerticalAlignment="Top"/>
                      <TextBlock Text="{Binding Temper}" TextWrapping="Wrap"/>
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Style="{StaticResource Footer}" Text="Read from each character's description and its species on the Talk tab, the same way voices are cast: words like bottom, ceiling, corner, quiet, cheerful, counts, sleepy or fast. Edit a description and this changes with it."/>
            </StackPanel>
          </GroupBox>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Bonds">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
          <GroupBox Header="Stories">
            <StackPanel>
              <TextBlock x:Name="BondsNeedsModel"/>
              <CheckBox x:Name="PlotsToggle" Content="Pairs who live together get a story" IsChecked="{Binding PlotsEnabled, Mode=TwoWay}"/>
              <DockPanel x:Name="PlotAfterRow" Margin="0,6,0,4">
                <TextBlock Text="First story after" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" Text="{Binding PlotAfterHours, StringFormat={}{0} h}"/>
                <Slider Minimum="0.25" Maximum="72" TickFrequency="0.25" Value="{Binding PlotAfterHours, Mode=TwoWay}"/>
              </DockPanel>
              <DockPanel x:Name="PlotLengthRow" Margin="0,4">
                <TextBlock Text="A story lasts" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" Width="120" Text="{Binding PlotLength, StringFormat={}{0} conversations}"/>
                <Slider Minimum="2" Maximum="20" TickFrequency="1" Value="{Binding PlotLength, Mode=TwoWay}"/>
              </DockPanel>
              <TextBlock x:Name="BondsFooter" Style="{StaticResource Footer}"/>
            </StackPanel>
          </GroupBox>
          <GroupBox x:Name="PlotPromptBox" Header="The prompt that writes a story">
            <StackPanel>
              <TextBox Text="{Binding PlotPrompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" MinHeight="200"/>
              <Button Content="Reset Prompt" HorizontalAlignment="Right" Click="ResetPlotPrompt_Click" Margin="0,6,0,0"/>
              <TextBlock x:Name="PlotPromptFooter" Style="{StaticResource Footer}"/>
            </StackPanel>
          </GroupBox>
          <GroupBox Header="Who lives with whom">
            <StackPanel>
              <TextBlock x:Name="BondsEmpty" Text="Nobody has shared the screen yet." Foreground="Gray"/>
              <ItemsControl x:Name="BondList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,4">
                      <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Forget" Tag="{Binding Key}" Click="ForgetBond_Click" FontSize="11" Padding="6,0"/>
                        <TextBlock Text="{Binding Names}" FontWeight="Bold"/>
                      </DockPanel>
                      <TextBlock Text="{Binding Details}" FontSize="11" Foreground="Gray"/>
                      <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Visibility="{Binding SummaryVisibility}"/>
                      <TextBlock Text="{Binding Story}" TextWrapping="Wrap" FontStyle="{Binding StoryStyle}" Foreground="{Binding StoryBrush}" Visibility="{Binding StoryVisibility}"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Style="{StaticResource Footer}" Text="Time counts while both are on screen, and is kept by name: rename a character and it starts again as a stranger."/>
            </StackPanel>
          </GroupBox>
          <GroupBox Header="The file">
            <DockPanel>
              <Button DockPanel.Dock="Right" x:Name="ForgetAllBonds" Content="Forget All" Click="ForgetAllBonds_Click" Margin="8,0,0,0"/>
              <Button DockPanel.Dock="Right" Content="Show in Explorer" Click="RevealBonds_Click"/>
              <TextBlock x:Name="BondsPath" FontSize="11" Foreground="Gray" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </DockPanel>
          </GroupBox>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Calendar">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
          <GroupBox Header="The day">
            <StackPanel>
              <TextBlock x:Name="CalendarNeedsModel"/>
              <CheckBox x:Name="KnowsTimeToggle" Content="They know the time of day" IsChecked="{Binding KnowsTimeOfDay, Mode=TwoWay}"/>
              <CheckBox x:Name="KnowsDateToggle" Content="They know the day of the week and the date" IsChecked="{Binding KnowsDate, Mode=TwoWay}" Margin="0,4,0,0"/>
              <TextBlock Style="{StaticResource Footer}" Text="Your PC's clock and calendar, told to the model before every line and paper plane: &quot;late evening (22:40)&quot;, &quot;Saturday, 26 September 2026&quot;. This is apart from the colony's own day and night, which only says when they sleep."/>
            </StackPanel>
          </GroupBox>
          <GroupBox Header="Holidays">
            <StackPanel>
              <CheckBox Content="Jewish holidays" IsChecked="{Binding JewishHolidays, Mode=TwoWay}"/>
              <CheckBox Content="Christian holidays" IsChecked="{Binding ChristianHolidays, Mode=TwoWay}" Margin="0,4,0,0"/>
              <CheckBox Content="Muslim holidays" IsChecked="{Binding MuslimHolidays, Mode=TwoWay}" Margin="0,4,0,0"/>
              <DockPanel x:Name="LookAheadRow" Margin="0,6,0,4">
                <TextBlock Text="Mention a holiday" Style="{StaticResource RowLabel}"/>
                <TextBlock x:Name="LookAheadValue" Style="{StaticResource RowValue}" Width="110"/>
                <Slider Minimum="0" Maximum="14" TickFrequency="1" Value="{Binding HolidayLookAhead, Mode=TwoWay}"/>
              </DockPanel>
              <TextBlock Style="{StaticResource Footer}" Text="On a holiday they know it, and which day of it (&quot;day 3 of Sukkot&quot;); before one, how far off it is. Jewish dates come from the Hebrew calendar and Muslim ones from the Islamic (Umm al-Qura) calendar, both built into Windows, so nothing is looked up online; a holiday that starts at sundown &quot;begins this evening&quot; the evening before. Where the new moon is sighted locally, a Muslim date can fall a day apart. With the built-in lines, one conversation in three on a holiday is about it; they only know a holiday on the day, so how far ahead to mention one needs a model."/>
            </StackPanel>
          </GroupBox>
          <GroupBox Header="What they know right now">
            <StackPanel>
              <TextBlock x:Name="CalendarNow" TextWrapping="Wrap"/>
              <TextBlock x:Name="CalendarNowFooter" Style="{StaticResource Footer}"/>
            </StackPanel>
          </GroupBox>
          <GroupBox Header="Coming up in the next 60 days">
            <StackPanel>
              <TextBlock x:Name="CalendarAheadEmpty" Foreground="Gray"/>
              <ItemsControl x:Name="CalendarAhead">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,2">
                      <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Foreground="Gray"/>
                      <TextBlock Text="{Binding Name}"/>
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </GroupBox>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Reminders">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
          <GroupBox Header="New reminder">
            <StackPanel>
              <DockPanel Margin="0,4">
                <TextBlock Text="Remind me to" Style="{StaticResource RowLabel}"/>
                <Grid>
                  <TextBox x:Name="ReminderText" KeyDown="ReminderText_KeyDown" TextChanged="ReminderText_Changed"/>
                  <TextBlock x:Name="ReminderHint" Text="Stretch, call mom, stand-up…" Foreground="Gray" IsHitTestVisible="False" Margin="5,0,0,0" VerticalAlignment="Center"/>
                </Grid>
              </DockPanel>
              <DockPanel Margin="0,4">
                <TextBlock Text="When" Style="{StaticResource RowLabel}"/>
                <TextBox x:Name="ReminderClock" DockPanel.Dock="Right" Width="60" Margin="8,0,0,0" LostFocus="ReminderClock_LostFocus" ToolTip="Time, 24-hour: 14:30"/>
                <DatePicker x:Name="ReminderDay" SelectedDateChanged="ReminderDay_Changed"/>
              </DockPanel>
              <DockPanel Margin="0,4">
                <TextBlock Text="Repeat" Style="{StaticResource RowLabel}"/>
                <ComboBox x:Name="ReminderRepeat" DisplayMemberPath="Title"/>
              </DockPanel>
              <DockPanel Margin="0,6,0,0">
                <Button x:Name="AddReminder" DockPanel.Dock="Right" Content="Add Reminder" Click="AddReminder_Click" IsEnabled="False"/>
                <StackPanel Orientation="Horizontal">
                  <Button Content="In 5 min" Tag="5" Click="ReminderSoon_Click" Margin="0,0,8,0"/>
                  <Button Content="In 30 min" Tag="30" Click="ReminderSoon_Click" Margin="0,0,8,0"/>
                  <Button Content="In 1 hour" Tag="60" Click="ReminderSoon_Click"/>
                </StackPanel>
              </DockPanel>
              <TextBlock Style="{StaticResource Footer}" Text="When the time comes, one of the creatures folds it into a paper plane and throws it at you. A time already past is delivered straight away. Repeating reminders keep their time of day; weekdays skip Saturday and Sunday."/>
            </StackPanel>
          </GroupBox>
          <GroupBox Header="Delivery">
            <StackPanel>
              <CheckBox Content="Reminders arrive by paper plane" IsChecked="{Binding RemindersEnabled, Mode=TwoWay}"/>
              <DockPanel Margin="0,6,0,4">
                <TextBlock Text="Letter stays open" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" Text="{Binding ReminderLetterSeconds, StringFormat={}{0} s}"/>
                <Slider Minimum="10" Maximum="600" TickFrequency="10" Value="{Binding ReminderLetterSeconds, Mode=TwoWay}"/>
              </DockPanel>
              <CheckBox Content="The thrower reads its note out loud" IsChecked="{Binding ReminderReadAloud, Mode=TwoWay}"/>
              <CheckBox Content="Add a Reminder… opens a paper note" IsChecked="{Binding ReminderPaperNote, Mode=TwoWay}" Margin="0,4,0,0"/>
              <Button Content="Send a Test Letter" Click="TestLetter_Click" HorizontalAlignment="Right" Margin="0,6,0,0"/>
              <TextBlock x:Name="ReminderFooter" Style="{StaticResource Footer}"/>
            </StackPanel>
          </GroupBox>
          <GroupBox Header="Your reminders">
            <StackPanel>
              <TextBlock x:Name="NoReminders" Text="No reminders yet." Foreground="Gray"/>
              <ItemsControl x:Name="ReminderList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,4">
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Margin="8,0,0,0"><Hyperlink Tag="{Binding Id}" Click="ReminderSend_Click">Send Now</Hyperlink></TextBlock>
                        <TextBlock Margin="8,0,0,0"><Hyperlink Tag="{Binding Id}" Click="ReminderDelete_Click">Delete</Hyperlink></TextBlock>
                      </StackPanel>
                      <StackPanel Opacity="{Binding Opacity}">
                        <TextBlock Text="{Binding Text}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding When}" FontSize="11" Foreground="Gray"/>
                      </StackPanel>
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Style="{StaticResource Footer}" Text="Sent one-off reminders stay here, greyed, until you clear them."/>
            </StackPanel>
          </GroupBox>
          <GroupBox Header="The file">
            <DockPanel>
              <Button x:Name="ClearSent" DockPanel.Dock="Right" Content="Clear Sent" Click="ClearSent_Click" Margin="8,0,0,0"/>
              <Button DockPanel.Dock="Right" Content="Show in Explorer" Click="RevealReminders_Click" Margin="8,0,0,0"/>
              <TextBox x:Name="RemindersPath" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>
            </DockPanel>
          </GroupBox>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Voice">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
          <GroupBox Header="Voice">
            <StackPanel>
              <CheckBox Content="Hear them talk out loud" IsChecked="{Binding VoiceEnabled, Mode=TwoWay}"/>
              <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Voices" Width="70" VerticalAlignment="Center"/>
                <RadioButton x:Name="EngineSystem" Content="Built-in voices" Checked="Engine_Checked" Margin="0,0,16,0"/>
                <RadioButton x:Name="EngineOr" Content="OpenRouter" Checked="Engine_Checked" Margin="0,0,16,0"/>
                <RadioButton x:Name="EngineLocal" Content="Local server" Checked="Engine_Checked"/>
              </StackPanel>
              <CheckBox Content="Every character gets a voice of their own" IsChecked="{Binding VoicePerCharacter, Mode=TwoWay}" Margin="0,6,0,0"/>
              <CheckBox Content="Cartoon voices: squeakier, sillier" IsChecked="{Binding CartoonVoices, Mode=TwoWay}" Margin="0,4,0,0"/>
              <CheckBox Content="Voices fit each character's personality" IsChecked="{Binding CastByPersonality, Mode=TwoWay}" Margin="0,4,0,0"/>
              <StackPanel x:Name="SystemVoicePanel" Margin="0,8,0,0">
                <DockPanel>
                  <TextBlock Text="Voice" Width="70" VerticalAlignment="Center"/>
                  <ComboBox x:Name="SystemVoiceBox" SelectionChanged="SystemVoiceBox_Changed"/>
                </DockPanel>
              </StackPanel>
              <StackPanel x:Name="OrVoicePanel" Margin="0,8,0,0">
                <DockPanel x:Name="VoiceKeyRow" Margin="0,0,0,4">
                  <TextBlock Text="API key" Width="70" VerticalAlignment="Center"/>
                  <PasswordBox x:Name="VoiceKey" PasswordChanged="VoiceKey_Changed"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,4">
                  <TextBlock Text="Model" Width="70" VerticalAlignment="Center"/>
                  <ComboBox x:Name="VoiceModelBox" SelectionChanged="VoiceModelBox_Changed"/>
                </DockPanel>
                <DockPanel>
                  <TextBlock Text="Voice" Width="70" VerticalAlignment="Center"/>
                  <ComboBox x:Name="OrVoiceBox" SelectionChanged="OrVoiceBox_Changed"/>
                </DockPanel>
                <CheckBox Content="Keep every line it says" IsChecked="{Binding KeepVoices, Mode=TwoWay}" Margin="0,6,0,0"/>
                <DockPanel Margin="0,4,0,0">
                  <TextBlock Text="Kept" Width="70" VerticalAlignment="Center"/>
                  <Button DockPanel.Dock="Right" Content="Show in Explorer" Click="RevealVoices_Click"/>
                  <TextBlock x:Name="KeptCount" Foreground="Gray" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock x:Name="VoiceListProblem" Foreground="Red" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,4,0,0"/>
              </StackPanel>
              <StackPanel x:Name="LocalVoicePanel" Margin="0,8,0,0">
                <DockPanel Margin="0,0,0,4">
                  <TextBlock Text="Server" Width="70" VerticalAlignment="Center"/>
                  <TextBox Text="{Binding LocalVoiceServer, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,4">
                  <TextBlock Text="Model" Width="70" VerticalAlignment="Center"/>
                  <TextBox Text="{Binding LocalVoiceModel, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <DockPanel>
                  <TextBlock Text="Voice" Width="70" VerticalAlignment="Center"/>
                  <ComboBox x:Name="LocalVoiceBox" SelectionChanged="LocalVoiceBox_Changed"/>
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                  <Button Content="Check" Click="LocalCheck_Click" MinWidth="60"/>
                  <Button Content="Copy Setup Command" Click="CopySetup_Click" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"><Run Text="Status: "/><Run x:Name="LocalCheckStatus" Text="not checked" Foreground="Gray"/></TextBlock>
              </StackPanel>
              <StackPanel x:Name="LineVoicePanel" Margin="0,6,0,0">
                <CheckBox Content="Save the built-in lines' voices" IsChecked="{Binding ReuseLineVoices, Mode=TwoWay}"/>
                <DockPanel Margin="0,4,0,0">
                  <TextBlock Text="Saved" Width="70" VerticalAlignment="Center"/>
                  <Button DockPanel.Dock="Right" x:Name="ClearLineVoices" Content="Clear" Click="ClearLineVoices_Click" Margin="8,0,0,0"/>
                  <Button DockPanel.Dock="Right" Content="Show in Explorer" Click="RevealLineVoices_Click"/>
                  <TextBlock x:Name="SavedCount" Foreground="Gray" VerticalAlignment="Center"/>
                </DockPanel>
              </StackPanel>
              <DockPanel Margin="0,8,0,4">
                <TextBlock Text="Speed" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" Text="{Binding VoiceSpeed, StringFormat={}{0:0.00}×}"/>
                <Slider Minimum="0.5" Maximum="2" TickFrequency="0.05" Value="{Binding VoiceSpeed, Mode=TwoWay}"/>
              </DockPanel>
              <DockPanel Margin="0,4">
                <TextBlock Text="Pitch" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" Text="{Binding VoicePitch, StringFormat={}{0:0.00}×}"/>
                <Slider Minimum="0.5" Maximum="2" TickFrequency="0.05" Value="{Binding VoicePitch, Mode=TwoWay}"/>
              </DockPanel>
              <CheckBox Content="Speed follows pitch: no echo, higher talks a little faster" IsChecked="{Binding SpeedFollowsPitch, Mode=TwoWay}" Margin="0,4"/>
              <DockPanel Margin="0,4">
                <TextBlock Text="Pause before the answer" Style="{StaticResource RowLabel}" Width="150"/>
                <TextBlock Style="{StaticResource RowValue}" Text="{Binding VoiceTurnPause, StringFormat={}{0:0.00} s}"/>
                <Slider Minimum="0" Maximum="2" TickFrequency="0.05" Value="{Binding VoiceTurnPause, Mode=TwoWay}"/>
              </DockPanel>
              <DockPanel Margin="0,4">
                <TextBlock Text="Volume" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource RowValue}" Text="{Binding VoiceVolume, StringFormat={}{0:0.00}}"/>
                <Slider Minimum="0" Maximum="1" TickFrequency="0.05" Value="{Binding VoiceVolume, Mode=TwoWay}"/>
              </DockPanel>
              <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="Test" Click="VoiceTest_Click" MinWidth="60"/>
                <Button Content="Stop" Click="VoiceStop_Click" MinWidth="60" Margin="8,0,0,0"/>
              </StackPanel>
              <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"><Run Text="Status: "/><Run x:Name="VoiceStatus" Foreground="Gray"/></TextBlock>
              <TextBlock x:Name="VoiceFooter" Style="{StaticResource Footer}"/>
            </StackPanel>
          </GroupBox>
          <GroupBox Header="Characters">
            <StackPanel>
              <TextBlock x:Name="NoVoiceCharacters" Text="Nobody on screen right now." Foreground="Gray"/>
              <StackPanel x:Name="CharacterVoiceList"/>
              <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button x:Name="CastEveryone" Content="Cast Everyone with Model" Click="CastEveryone_Click"/>
              </StackPanel>
              <TextBlock x:Name="VoiceNeedsModel" Margin="0,6,0,0"/>
              <TextBlock x:Name="CastAllNote" FontSize="11" Foreground="Gray" TextWrapping="Wrap" Visibility="Collapsed"/>
              <TextBlock Style="{StaticResource Footer}" Text="The characters on screen now. Each starts automatic: with &quot;Voices fit each character's personality&quot; on, their description and species choose the voice, pitch and speed (old and slow, tiny and quick, a robot, a ghost…); off, voices are only handed out to differ. &quot;Cast with Model&quot; asks the brain model instead, which understands any description, and keeps its choice as the character's own; it costs one call. A voice picked here is theirs alone; the automatic ones go round it. Speed and Pitch here multiply the overall sliders above; Speed follows pitch can be set for one character alone. &quot;Auto&quot; puts a character back to automatic. Settings follow the name, on every engine; an OpenRouter voice the chosen model does not have is ignored. With the Local server, &quot;Custom blend…&quot; mixes Kokoro voices, af_bella(2)+am_puck(1) being two parts Bella to one of Puck: endless voices from the 72, free. OpenRouter's Kokoro refuses blends."/>
            </StackPanel>
          </GroupBox>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Costs">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
          <GroupBox Header="Spent">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="100"/><ColumnDefinition Width="90"/><ColumnDefinition Width="60"/><ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Cost" FontSize="11" Foreground="Gray"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Calls" FontSize="11" Foreground="Gray"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="Tokens" FontSize="11" Foreground="Gray"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Today"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TodayCost"/><TextBlock Grid.Row="1" Grid.Column="2" x:Name="TodayCalls"/><TextBlock Grid.Row="1" Grid.Column="3" x:Name="TodayTokens"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="This month"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="MonthCost"/><TextBlock Grid.Row="2" Grid.Column="2" x:Name="MonthCalls"/><TextBlock Grid.Row="2" Grid.Column="3" x:Name="MonthTokens"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="All time"/>
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="AllCost"/><TextBlock Grid.Row="3" Grid.Column="2" x:Name="AllCalls"/><TextBlock Grid.Row="3" Grid.Column="3" x:Name="AllTokens"/>
              </Grid>
              <TextBlock x:Name="SpendFooter" Style="{StaticResource Footer}"/>
            </StackPanel>
          </GroupBox>
          <GroupBox Header="By feature">
            <StackPanel>
              <TextBlock x:Name="NoPurposes" Text="Nothing yet." Foreground="Gray"/>
              <ItemsControl x:Name="SpendPurposes">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,1"><TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Foreground="Gray"/><TextBlock Text="{Binding Name}"/></DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Style="{StaticResource Footer}" Text="Talk is the meetings and pokes (two calls a conversation); paper planes the notes and the catcher's thought; voice every line said by a paid speech model; voice casting each Cast with Model; relationship plots one call per story a pair gets (Bonds tab). Calls from before features were labelled are counted apart."/>
            </StackPanel>
          </GroupBox>
          <GroupBox Header="By model">
            <ItemsControl x:Name="SpendModels">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,1"><TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" FontSize="11" Foreground="Gray"/><TextBlock Text="{Binding Name}" FontSize="11"/></DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </GroupBox>
          <GroupBox Header="Latest calls">
            <StackPanel>
              <TextBlock x:Name="NoCalls" Text="No calls yet." Foreground="Gray"/>
              <ItemsControl x:Name="RecentCalls">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,2">
                      <TextBlock DockPanel.Dock="Right" Text="{Binding Cost}" Foreground="{Binding CostBrush}" VerticalAlignment="Center"/>
                      <StackPanel>
                        <TextBlock Text="{Binding Model}" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="Gray"/>
                      </StackPanel>
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock x:Name="RecentFooter" Style="{StaticResource Footer}"/>
            </StackPanel>
          </GroupBox>
          <GroupBox Header="The file">
            <StackPanel>
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="Show in Explorer" Click="RevealSpend_Click"/>
                <TextBlock x:Name="SpendPath" FontSize="11" Foreground="Gray" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
              </DockPanel>
              <TextBlock Style="{StaticResource Footer}" Text="spend.jsonl, one JSON line per call: time, provider, model, feature, tokens and cost. Plain text on purpose."/>
            </StackPanel>
          </GroupBox>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Chats">
      <DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="10">
          <Button DockPanel.Dock="Right" Content="Open in Terminal" Click="OpenTerminal_Click" Margin="8,0,0,0"/>
          <Button DockPanel.Dock="Right" Content="Open in Explorer" Click="OpenChats_Click"/>
          <TextBlock x:Name="ChatsPath" FontSize="11" Foreground="Gray" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </DockPanel>
        <ListBox DockPanel.Dock="Left" x:Name="DayList" Width="150" SelectionChanged="DayList_Changed" DisplayMemberPath="Title"/>
        <Grid>
          <TextBlock x:Name="ChatsEmpty" Foreground="Gray" TextWrapping="Wrap" TextAlignment="Center" Margin="24" VerticalAlignment="Center"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ExchangeList" Margin="12">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,0,14">
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="{Binding Cost}" FontSize="11" Foreground="Gray" Margin="8,0,0,0"/>
                        <TextBlock Text="{Binding Tokens}" FontSize="11" Foreground="Gray" Margin="8,0,0,0"/>
                        <TextBlock Text="{Binding Voice}" ToolTip="{Binding VoiceModels}" FontSize="11" Foreground="Gray" Margin="8,0,0,0"/>
                      </StackPanel>
                      <TextBlock Text="{Binding Time}" FontSize="11" Foreground="Gray"/>
                      <TextBlock Text="{Binding Model}" FontSize="11" Foreground="Gray" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Situation}" FontSize="11" Foreground="DarkGray" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Plot}" Visibility="{Binding PlotVisibility}" FontSize="11" FontStyle="Italic" Foreground="DarkGray" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding Lines}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <TextBlock TextWrapping="Wrap" ui:StyledLine.Line="{Binding}"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </DockPanel>
    </TabItem>
  </TabControl>
</Window>
