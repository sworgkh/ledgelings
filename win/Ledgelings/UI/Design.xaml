<!-- The shared look for the ordinary windows (docs/DESIGN.md), merged by the settings window and the
     Weather & Sky panel: the same parts as the Mac's Design.swift. The pixel paper's sizes are in Design.cs. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!-- The spacing scale: every gap and margin is one of these. -->
  <sys:Double x:Key="SpaceXs">4</sys:Double>
  <sys:Double x:Key="SpaceS">8</sys:Double>
  <sys:Double x:Key="SpaceM">12</sys:Double>
  <sys:Double x:Key="SpaceL">16</sys:Double>
  <sys:Double x:Key="SpaceXl">24</sys:Double>

  <!-- A section's footer: what its settings do, in plain words. -->
  <Style x:Key="Footer" TargetType="TextBlock">
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Foreground" Value="Gray"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Margin" Value="0,8,0,0"/>
  </Style>
  <!-- A row's label, on the left. Russian labels run longer: they wrap rather than lose their ends. -->
  <Style x:Key="RowLabel" TargetType="TextBlock">
    <Setter Property="Width" Value="110"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <!-- The value printed beside a slider: "5 min", "no limit". It never wraps. -->
  <Style x:Key="RowValue" TargetType="TextBlock">
    <Setter Property="MinWidth" Value="76"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="TextAlignment" Value="Right"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="8,0,0,0"/>
    <Setter Property="DockPanel.Dock" Value="Right"/>
  </Style>
  <!-- A button inside a list row (Forget, Reset, Play it): small, the same everywhere. -->
  <Style x:Key="RowAction" TargetType="Button">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="Margin" Value="8,0,0,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style TargetType="GroupBox">
    <Setter Property="Padding" Value="8"/>
    <Setter Property="Margin" Value="0,0,0,12"/>
  </Style>
  <Style TargetType="Slider">
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="IsSnapToTickEnabled" Value="True"/>
  </Style>
</ResourceDictionary>
