<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Windows app: tray icon, one layered overlay window per monitor, a WPF settings window. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms is not used for UI; its profile of the desktop framework carries GDI+ (System.Drawing). -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Ledgelings</RootNamespace>
    <AssemblyName>Ledgelings</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('app.ico')">app.ico</ApplicationIcon>
    <StartupObject>Ledgelings.Program</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WFO0003: WinForms wants dpi set in code; the manifest is right for the raw Win32 overlays. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\LedgelingsCore\LedgelingsCore.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The WPF SDK leaves these out of its implicit usings. -->
    <Using Include="System.IO" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <!-- The sprite sheets are shared with the macOS app: one set of art, copied next to the exe. -->
    <Content Include="..\..\Sources\Ledgelings\Resources\sprites\*.png;..\..\Sources\Ledgelings\Resources\sprites\*.json"
             Link="sprites\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
